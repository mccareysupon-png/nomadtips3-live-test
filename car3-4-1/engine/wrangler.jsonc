{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"nomadtips3-car341-engine",
  "main":"src/index.js",
  "compatibility_date":"2026-08-20",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":true,
  "triggers":{"crons":["*/2 * * * *"]},
  "services":[{"binding":"SOURCE","service":"nomadtips3-car341-source-monitor"}],
  "durable_objects":{"bindings":[{"name":"CAR341_STATE","class_name":"Car341State"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["Car341State"]}],
  "observability":{"enabled":true,"logs":{"head_sampling_rate":1}},
  "vars":{"REAL_MARKET_BOOKMAKER":"1xbet"}
}
