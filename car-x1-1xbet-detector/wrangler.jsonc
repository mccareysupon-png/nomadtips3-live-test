{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nomadtips3-x1-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "X1_STATE", "class_name": "X1State" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["X1State"] }
  ],
  "triggers": { "crons": ["*/1 * * * *"] }
}
