{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomadtips3-car33-live",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "CAR33_STATE", "class_name": "Car33State" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Car33State"] }
  ],
  "assets": {
    "directory": "../web",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
