{
  "name": "add-k-ah-detector",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DETECTOR",
        "class_name": "DetectorState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DetectorState"]
    }
  ],
  "vars": {
    "NOMAD_FEED_URL": "https://www.nomadtips3.com/nomad-live-342/feed?force=1",
    "PRODUCTION_ENABLED": "false"
  }
}
