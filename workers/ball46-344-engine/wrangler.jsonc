{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ball46-344-engine",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "durable_objects": {
    "bindings": [
      { "name": "STATE", "class_name": "Ball46State" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Ball46State"] }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
