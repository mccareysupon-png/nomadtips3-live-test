{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomadtips3-343-auto-engine",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "durable_objects": {
    "bindings": [
      {
        "name": "STATE",
        "class_name": "Nomad343State"
      }
    ]
