r(--b46m-stat-bg2,#20382b))!important;\n  box-shadow:inset 0 0 0 1px rgba(113,206,146,.42)!important;\n }\n html body .workspace.singlepage .b46m14-label{\n  display:block!important;\n  width:100%;\n  font-size:7.1px!important;\n  font-weight:790!important;\n  line-height:1.18!important;\n  letter-spacing:0!important;\n  color:var(--b46m-stat-sub,#A4C7B3)!important;\n  white-space:normal!important;\n  overflow-wrap:anywhere;\n  text-align:center!important;\n }\n html body .workspace.singlepage .b46m14-value{\n  display:block!important;\n  width:100%;\n  font-size:clamp(9px,2.35vw,11px)!important;\n  font-weight:850!important;\n  line-height:1.2!important;\n  letter-spacing:-.035em!important;\n  font-variant-numeric:tabular-nums;\n  color:var(--b46m-stat-ink,#EDF9F1)!important;\n  white-space:normal!important;\n  overflow-wrap:anywhere!important;\n  word-break:break-word!important;\n  text-align:center!important;\n  margin:4px 0 0!important;\n }\n html body .workspace.singlepage .b46m14-card[data-kpi=\"3\"] .b46m14-value,\n html body .workspace.singlepage .b46m14-card[data-kpi=\"9\"] .b46m14-value,\n html body .workspace.singlepage .b46m14-card[data-kpi=\"10\"] .b46m14-value{color:#5BE0A5!important}\n html body .workspace.singlepage .b46m14-card[data-kpi=\"4\"] .b46m14-value,\n html body .workspace.singlepage .b46m14-card[data-kpi=\"14\"] .b46m14-value{color:#F3899B!important}\n html:not([data-theme=\"dark\"]) body .workspace.singlepage .b46m14-card[data-kpi=\"3\"] .b46m14-value,\n html:not([data-theme=\"dark\"]) body .workspace.singlepage .b46m14-card[data-kpi=\"9\"] .b46m14-value,\n html:not([data-theme=\"dark\"]) body .workspace.singlepage .b46m14-card[data-kpi=\"10\"] .b46m14-value{color:#198257!important}\n html:not([data-theme=\"dark\"]) body .workspace.singlepage .b46m14-card[data-kpi=\"4\"] .b46m14-value,\n html:not([data-theme=\"dark\"]) body .workspace.singlepage .b46m14-card[data-kpi=\"14\"] .b46m14-value{color:#AE4050!important}\n html body .workspace.singlepage .b46m14-card[data-kpi=\"12\"] .b46m14-value{\n  font-size:8.3px!important;\n  letter-spacing:-.045em!important;\n }\n html body .workspace.singlepage .b46m14-detail{\n  display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 9px;\n  margin-top:5px;padding:8px 10px;\n  border-radius:7px;\n  background:var(--b46m-stat-bg,#16291F);\n  color:var(--b46m-stat-ink,#E8F6EE);\n  box-shadow:inset 0 1px 0 rgba(255,255,255,.055);\n }\n html body .workspace.singlepage .b46m14-detail[hidden]{display:none!important}\n html body .workspace.singlepage .b46m14-detail-label{\n  color:var(--b46m-stat-sub,#A4C7B3);font-size:10px;font-weight:760;\n }\n html body .workspace.singlepage .b46m14-detail-value{\n  color:var(--b46m-stat-ink,#EDF9F1);font-size:15px;font-weight:850;\n  font-variant-numeric:tabular-nums;overflow-wrap:anywhere;\n }\n html body .workspace.singlepage .b46m14-detail-meta{\n  width:100%;color:var(--b46m-stat-dim,#83AC93);font-size:10px;line-height:1.3;\n }\n html body .workspace.singlepage .b46m14-card:focus-visible{\n  outline:2px solid #70DBA7!important;outline-offset:1px!important\n }\n}\n@media(max-width:360px){\n html body .workspace.singlepage .b46m14-grid{gap:3px!important}\n html body .workspace.singlepage .b46m14-card{padding:5px 1px!important}\n html body .workspace.singlepage .b46m14-value{font-size:9px!important}\n}\n</style>";
const js="<script id=\"b46-mobile-stats-clean-v1-script-20261020\">(function(){\n 'use strict';\n if(window.__b46MobileStatsCleanV1Installed)return;\n window.__b46MobileStatsCleanV1Installed=true;\n const LIMIT=12,RESULT_SEL='.workspace.singlepage .sp-stats-content .sp-results';\n const cssShort=s=>String(s||'').replace(/\\s+/g,' ').trim();\n const get=e=>cssShort(e?.textContent);\n let root=null,host=null,list=null,more=null,currentSig='',shown=LIMIT,expanded=new Set();\n function append(tag,cls,txt,parent,title){\n   const e=document.createElement(tag);e.className=cls;\n   if(txt!==undefined&&txt!==null)e.textContent=txt;\n   if(title)e.title=title;\n   if(parent)parent.appendChild(e);\n   return e;\n }\n function remove(){\n   if(root)root.classList.remove('b46m-stats-ready');\n   if(host)host.remove();\n   root=null;host=null;list=null;more=null;shown=LIMIT;currentSig='';expanded=new Set();\n }\n function rowsOf(ul){return [...ul.querySelectorAll('.sp-table tbody tr')].filter(tr=>tr.querySelectorAll(':scope > td').length>=10)}\n function rowData(tr,index){\n   const c=[...tr.querySelectorAll(':scope > td')];\n   const match=c[1]?.querySelector('.sp-match');\n   const full=get(match?.querySelector('strong'))||get(c[1]);\n   const league=get(match?.querySelector('small'));\n   let teams=full.split(/\\s+[—–]\\s+/);\n   if(teams.length<2)teams=full.split(/\\s+vs\\.?\\s+/i);\n   const home=teams[0]||full,away=teams.length>=2?teams.slice(1).join(' — '):'—';\n   const entryTexts=[...c[7].querySelectorAll('span,small')].map(get).filter(Boolean);\n   const entryScore=entryTexts[0]||get(c[7]).split(/ENTRY/i)[0].trim()||'—';\n   const finalTexts=[...c[8].querySelectorAll('span,small')].map(get).filter(Boolean);\n   const finalScore=finalTexts[0]||get(c[8]).split(/\\s+FT/i)[0].trim()||'—';\n   const state=get(c[9].querySelector('.sp-result'))||get(c[9]).split('·')[0]||'—';\n   const color=/\\bWIN\\b/i.test(state)?'win':/\\bLOSS\\b/i.test(state)?'loss':/PENDING|UNSETTLED/i.test(state)?'pending':'neutral';\n   const date=get(c[0]),market=get(c[2]),pick=get(c[3]),line=get(c[4]),odds=get(c[5]),bookmaker=get(c[6]),source=get(c[9].querySelector('.sp-result-source')),entry=get(c[7]),final=get(c[8]);\n   return{index,date,league,home,away,market,pick,line,odds,bookmaker,source,entry,final,entryScore,finalScore,state,color};\n }\n function readableMarket(str){\n   return str.replace(/\\bFull Time\\b/gi,'FT').replace(/\\bHalf Time\\b/gi,'HT');\n }\n function extraItem(parent,name,value,full=false){\n   const cell=append('div','b46m-extra-item'+(full?' full':''),null,parent);\n   append('label','',name,cell);\n   append('span','',value||'—',cell);\n }\n function card(data){\n   const c=append('article','b46m-hcard',null,list);c.dataset.index=String(data.index);\n   if(expanded.has(data.index))c.dataset.expanded='true';\n   const heading=append('div','b46m-hhead',null,c);\n   append('span','b46m-league',data.league||'League —',heading,data.league);\n   append('time','b46m-date',data.date,heading,data.date);\n   const teams=append('div','b46m-teams',null,c);\n   for(const [typ,name] of [['home',data.home],['away',data.away]]){\n     const line=append('div','b46m-teamline',null,teams);\n     append('span','b46m-teamtag'+(typ==='away'?' away':''),typ==='home'?'H':'A',line);\n     append('span','b46m-teamname',name,line,name);\n   }\n   const pickbar=append('div','b46m-pickbar',null,c);\n   const market=readableMarket(data.market);\n   append('span','b46m-market',market||'Market —',pickbar,data.market);\n   append('strong','b46m-odds',data.odds&&data.odds!=='—'?data.odds:'—',pickbar,'Odds '+data.odds);\n   const foot=append('div','b46m-hfoot',null,c);\n   const scores=append('div','b46m-scoreline',null,foot);\n   append('span','', 'Entry',scores);\n   append('strong','',data.entryScore||'—',scores);\n   append('span','arrow','→',scores);\n   append('strong','',data.finalScore||'—',scores);\n   append('span','b46m-outcome '+data.color,data.state,foot);\n   const button=append('button','b46m-detail-toggle',expanded.has(data.index)?'− Less details':'+ Match details',c);\n   button.type='button';button.dataset.expand=String(data.index);button.setAttribute('aria-expanded',expanded.has(data.index)?'true':'false');\n   const extra=append('div','b46m-extra',null,c);\n   extraItem(extra,'Match',data.home+' — '+data.away,true);\n   extraItem(extra,'League',data.league,true);\n   extraItem(extra,'Market',data.market);\n   extraItem(extra,'Pick',data.pick);\n   extraItem(extra,'Line',data.line);\n   extraItem(extra,'Odds',data.odds);\n   extraItem(extra,'Bookmaker / Referee',data.bookmaker,true);\n   extraItem(extra,'Entry',data.entry,true);\n   extraItem(extra,'Final',data.final,true);\n   extraItem(extra,'Result source',data.source,true);\n   return c;\n }\n function render(data){\n   if(!list||!more)return;\n   expanded=new Set([...expanded].filter(v=>v<data.length));\n   list.replaceChildren();\n   const max=Math.min(data.length,shown);\n   for(const row of data.slice(0,max))card(row);\n   more.hidden=max>=data.length;\n   more.textContent='Show more · '+max+' / '+data.length;\n   if(!data.length)append('div','b46m-history-empty','No records in the current view',list);\n }\n function install(next){\n   root=next;\n   host=append('div','b46m-history',null,null);\n   host.setAttribute('aria-label','Settled Signal History in mobile card view');\n   list=append('div','b46m-history-list',null,host);\n   more=append('button','b46m-more',null,host);\n   more.type='button';\n   more.addEventListener('click',()=>{shown+=LIMIT;const rows=rowsOf(root).map(rowData);render(rows);});\n   host.addEventListener('click',e=>{\n     const button=e.target.closest('[data-expand]');\n     if(!button||!host.contains(button))return;\n     const index=Number(button.dataset.expand);\n     if(expanded.has(index))expanded.delete(index);else expanded.add(index);\n     const card=button.closest('.b46m-hcard');\n     card.dataset.expanded=expanded.has(index)?'true':'false';\n     button.setAttribute('aria-expanded',expanded.has(index)?'true':'false');\n     button.textContent=expanded.has(index)?'− Less details':'+ Match details';\n   });\n   root.appendChild(host);\n }\n function tick(){\n   const e=document.querySelector(RESULT_SEL);\n   if(e!==root)remove();\n   if(!e||!window.matchMedia('(max-width:767px)').matches){if(root)remove();return;}\n   const table=e.querySelector('.sp-table');\n   if(!table)return;\n   const tr=rowsOf(e);\n   if(!tr.length){if(root){root.classList.remove('b46m-stats-ready');host?.remove();root=null;host=null;list=null;more=null;}return;}\n   if(!root)install(e);\n   // Source table stays authoritative; digest catches updates, filters and pagination.\n   const sig=tr.length+'|'+tr.map(x=>cssShort(x.textContent)).join('\\u001f');\n   if(sig!==currentSig){\n     if(currentSig){shown=LIMIT;expanded.clear();}\n     currentSig=sig;\n     const data=tr.map(rowData);\n     render(data);\n   }\n   e.classList.add('b46m-stats-ready');\n }\n const start=()=>{tick();setInterval(tick,1100);window.addEventListener('resize',tick,{passive:true});};\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();\n})();</script><script id=\"b46-mobile-stats-14-kpi-7x2-20261020\">(function(){\n 'use strict';\n if(window.__b46Mobile14Kpi7x2Installed)return;\n window.__b46Mobile14Kpi7x2Installed=true;\n const ROOT='.workspace.singlepage .sp-stats-content';\n let prior=null,strip=null,grid=null,detail=null,priorSignature='',selected=-1;\n const text=e=>(e?.textContent||'').replace(/\\s+/g,' ').trim();\n const one=(root,sel)=>root.querySelector(sel);\n function values(root){\n  const top=[...root.querySelectorAll('.sp-kpis .sp-kpi')];\n  const perf=[...root.querySelectorAll('.b46-perf-kpis .b46-perf-kpi')];\n  if(top.length!==8||perf.length!==6)return null;\n  const items=[\n   ...top.map((e,i)=>({i:i+1,label:text(one(e,'span')),value:text(one(e,'strong')),meta:text(one(e,'small'))})),\n   ...perf.map((e,i)=>({i:i+9,label:text(one(e,'span')),value:text(one(e,'b')),meta:text(one(e,'small'))}))\n  ];\n  return items.every(x=>x.label&&x.value)?items:null;\n }\n function clear(){\n  if(prior)prior.classList.remove('b46m14-ready');\n  if(strip)strip.remove();\n  prior=null;strip=null;grid=null;detail=null;priorSignature='';selected=-1;\n }\n function mk(tag,className,parent){\n  const e=document.createElement(tag);e.className=className;if(parent)parent.appendChild(e);return e;\n }\n function initialize(root){\n  strip=mk('section','b46m14-strip');\n  strip.setAttribute('aria-label','14 statistics, seven per row');\n  grid=mk('div','b46m14-grid',strip);\n  for(let i=0;i<14;i++){\n   const card=mk('button','b46m14-card',grid);\n   card.type='button';\n   card.dataset.index=String(i);\n   card.setAttribute('aria-pressed','false');\n   mk('span','b46m14-label',card);\n   mk('strong','b46m14-value',card);\n   card.addEventListener('click',()=>{\n    if(selected===i){selected=-1;detail.hidden=true;}\n    else{selected=i;const items=values(root);if(items)showDetail(items[i]);}\n    refreshSelected();\n   });\n  }\n  detail=mk('div','b46m14-detail',strip);\n  detail.hidden=true;\n  const hero=one(root,'.sp-stat-hero');\n  if(!hero){strip.remove();strip=null;grid=null;detail=null;return false}\n  hero.insertAdjacentElement('afterend',strip);\n  prior=root;\n  return true;\n }\n function refreshSelected(){\n  if(!grid)return;\n  [...grid.children].forEach((e,i)=>e.setAttribute('aria-pressed',selected===i?'true':'false'));\n }\n function showDetail(item){\n  if(!detail||!item)return;\n  detail.replaceChildren();\n  const label=mk('span','b46m14-detail-label',detail);label.textContent=item.label;\n  const value=mk('strong','b46m14-detail-value',detail);value.textContent=item.value;\n  if(item.meta){const sub=mk('span','b46m14-detail-meta',detail);sub.textContent=item.meta;}\n  detail.hidden=false;\n }\n function update(){\n  const root=document.querySelector(ROOT);\n  if(root!==prior&&prior)clear();\n  if(!root||!window.matchMedia('(max-width:767px)').matches){\n   if(prior)clear();\n   return;\n  }\n  const items=values(root);\n  if(!items){if(prior)clear();return}\n  if(!strip&&!initialize(root))return;\n  const signature=items.map(x=>x.label+'\\u001e'+x.value+'\\u001e'+x.meta).join('\\u001f');\n  if(priorSignature!==signature){\n   if(!grid||grid.children.length!==14){clear();return}\n   for(let i=0;i<14;i++){\n    const card=grid.children[i],item=items[i];\n    card.children[0].textContent=item.label;\n    card.children[1].textContent=item.value;\n    card.title=item.label+' — '+item.value+(item.meta?' · '+item.meta:'');\n    card.setAttribute('aria-label',card.title);\n    card.dataset.kpi=String(item.i);\n   }\n   priorSignature=signature;\n   if(selected>=0)showDetail(items[selected]);\n  }\n  root.classList.add('b46m14-ready');\n }\n const start=()=>{update();setInterval(update,1000);window.addEventListener('resize',update,{passive:true});document.addEventListener('visibilitychange',()=>{if(!document.hidden)update()})};\n if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();\n})();</script>";
