const patched=raw.replace("</head>","<style id=\"b46-featured-clean-recessed-production-20261021-style\">/* BALL46 Featured Match — Clean Sections V1 (Browser Preview only).\n   Mirror-only rendering. No changes to real card, feed, engine or signals. */\n.b46fm-preview-pc,.b46fm-preview-mobile{--fm-surface:#132820;--fm-depth:#1a3328;--fm-inner:#192f25;--fm-fg:#e8f5eb;--fm-dim:#91b7a2;--fm-muted:#648c78;--fm-green:#38c991;--fm-gold:#dfbe4d;--fm-orange:#f0ab6b;--fm-separator:rgba(136,204,160,.10);color:var(--fm-fg);font-family:inherit}\nhtml[data-theme=\"light\"] .b46fm-preview-pc,html[data-theme=\"light\"] .b46fm-preview-mobile{--fm-surface:#f4f9f5;--fm-depth:#e6f0e9;--fm-inner:#eaf3ec;--fm-fg:#193e2b;--fm-dim:#597d67;--fm-muted:#7b9985;--fm-green:#21845b;--fm-gold:#ad8718;--fm-orange:#aa5b27;--fm-separator:rgba(59,100,73,.10)}\n.b46fm{box-sizing:border-box;width:100%;max-width:100%;min-width:0;padding:14px 12px 13px!important;border:0!important;border-radius:13px!important;background:linear-gradient(156deg,var(--fm-depth),var(--fm-surface) 50%,var(--fm-surface))!important;box-shadow:inset 0 1px 0 rgba(183,254,206,.045),0 5px 18px rgba(0,0,0,.11)!important;overflow:hidden;font-size:12px}\n.b46fm *{box-sizing:border-box;min-width:0}\n.b46fm .fm-section{margin-top:12px}\n.b46fm .fm-caption{font-size:9px;font-weight:800;letter-spacing:.10em;line-height:1.25;color:var(--fm-dim);text-transform:uppercase}\n.b46fm .fm-header{display:flex;gap:9px;align-items:flex-start;justify-content:space-between}\n.b46fm .fm-header-main{min-width:0;flex:1}\n.b46fm .fm-eyebrow{display:flex;align-items:center;gap:7px;color:var(--fm-green);font-size:9px;line-height:1.3;letter-spacing:.11em;font-weight:850}\n.b46fm .fm-live-dot{width:5px;height:5px;background:var(--fm-green);border-radius:50%;box-shadow:0 0 0 3px rgba(52,185,128,.09);flex:0 0 auto}\n.b46fm .fm-league{display:flex;align-items:center;gap:6px;margin-top:6px;color:var(--fm-fg);font-weight:790;font-size:12px;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.b46fm .fm-league img{max-width:15px;height:auto;flex:none}\n.b46fm .fm-minute{flex:0 0 auto;min-width:29px;text-align:center;border-radius:8px;background:rgba(51,197,126,.13);color:var(--fm-green);padding:7px 7px 6px;font-size:10px;font-weight:850;font-variant-numeric:tabular-nums;line-height:1}\n.b46fm .fm-score{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:7px;margin-top:14px;padding:13px 0 12px;border-top:1px solid var(--fm-separator);border-bottom:1px solid var(--fm-separator)}\n.b46fm .fm-team{display:flex;flex-direction:column;gap:5px;align-items:flex-start}\n.b46fm .fm-team.away{align-items:flex-end;text-align:right}\n.b46fm .fm-team .fm-type{font-size:8px;font-weight:760;letter-spacing:.10em;color:var(--fm-muted)}\n.b46fm .fm-team strong{font-size:12px;font-weight:850;line-height:1.2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;width:100%}\n.b46fm .fm-team.home strong{color:var(--fm-green)}\n.b46fm .fm-team.away strong{color:var(--fm-orange)}\n.b46fm .fm-score-number{text-align:center;white-space:nowrap;font-size:25px;letter-spacing:-.07em;font-weight:850;color:var(--fm-fg);font-variant-numeric:tabular-nums}\n.b46fm .fm-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;margin-top:10px}\n.b46fm .fm-fact{display:flex;flex-direction:column;justify-content:center;min-height:47px;padding:8px 9px;border-radius:9px;background:var(--fm-inner)}\n.b46fm .fm-fact span{font-size:8px;letter-spacing:.06em;color:var(--fm-dim);font-weight:760;line-height:1.25}\n.b46fm .fm-fact b{margin-top:4px;font-size:11px;line-height:1.22;color:var(--fm-fg);font-weight:810;overflow-wrap:anywhere}\n.b46fm .fm-fact[data-name*=\"CARDS\"] b{font-size:9px}\n.b46fm .fm-section-top{display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:8px}\n.b46fm .fm-inline-note{font-size:9px;color:var(--fm-muted);font-weight:660}\n.b46fm .fm-signal-container{display:grid;gap:6px}\n.b46fm .fm-signal{padding:9px 10px!important;background:rgba(29,113,73,.19)!important;color:var(--fm-fg);border-radius:9px!important;border:0!important;box-shadow:inset 0 1px 0 rgba(76,221,155,.06)!important;overflow-wrap:anywhere}\n.b46fm .fm-signal .feature-signal{background:transparent!important;border:0!important;padding:0!important;margin:0!important;color:inherit}\n.b46fm .fm-signal .feature-signal > *{border:0!important;box-shadow:none!important;max-width:100%!important}\n.b46fm .fm-signal .feature-signal b,.b46fm .fm-signal .feature-signal strong{color:var(--fm-green)!important}\n.b46fm .fm-signal .feature-signal span,.b46fm .fm-signal .feature-signal small{font-size:9px}\n.b46fm .fm-empty{display:flex;justify-content:center;align-items:center;min-height:37px;border-radius:8px;background:var(--fm-inner);color:var(--fm-muted);font-size:10px;text-align:center;padding:8px}\n.b46fm .fm-stats{display:grid;gap:7px}\n.b46fm .fm-stat{display:grid;gap:5px}\n.b46fm .fm-stat-info{display:grid;grid-template-columns:37px minmax(0,1fr) 37px;align-items:center;gap:3px;font-variant-numeric:tabular-nums}\n.b46fm .fm-stat-info b{font-size:10px;font-weight:850;color:var(--fm-green)}\n.b46fm .fm-stat-info b:last-child{text-align:right;color:var(--fm-gold)}\n.b46fm .fm-stat-name{text-align:center;color:var(--fm-dim);font-size:10px;font-weight:680;line-height:1.15}\n.b46fm .fm-bars{display:grid;grid-template-columns:1fr 1fr;gap:5px}\n.b46fm .fm-track{height:4px;background:rgba(100,124,108,.17);overflow:hidden;border-radius:8px;display:flex;align-items:center}\n.b46fm .fm-track.home{justify-content:flex-end}\n.b46fm .fm-track.away{justify-content:flex-start}\n.b46fm .fm-track>i{height:100%;border-radius:8px;background:var(--fm-green);display:block}\n.b46fm .fm-track.away>i{background:var(--fm-gold)}\n.b46fm .fm-events{display:grid;gap:5px}\n.b46fm .fm-event{display:grid;grid-template-columns:38px minmax(0,1fr);gap:7px;align-items:center;padding:5px 7px;border-radius:6px;background:var(--fm-inner)}\n.b46fm .fm-event time{color:var(--fm-green);font-weight:820;font-size:10px;font-variant-numeric:tabular-nums}\n.b46fm .fm-event span{color:var(--fm-dim);font-size:10px;line-height:1.35}\n.b46fm .fm-more{display:flex;width:100%;align-items:center;justify-content:center;gap:4px;color:var(--fm-green)!important;font-weight:740;font-size:10px;border:0!important;background:transparent!important;min-height:28px;cursor:pointer;padding:4px 8px!important;border-radius:6px}\n.b46fm .fm-more:focus-visible{outline:2px solid var(--fm-green);outline-offset:2px}\n.b46fm-preview-pc{width:100%;margin:0!important}\n.b46fm-preview-pc .b46fm{border-radius:12px!important}\nhtml body .featured-card.b46fm-source-hidden{display:none!important}\n.b46fm-preview-mobile{display:none}\n@media(max-width:767px){\n .b46fm-preview-mobile{display:block!important;width:100%;padding:0 8px 10px;margin:0 auto}\n .b46fm-preview-mobile .b46fm{width:100%;max-width:600px;margin:0 auto;padding:15px 14px!important}\n .b46fm-preview-mobile .fm-score-number{font-size:32px}\n .b46fm-preview-mobile .fm-team strong{font-size:14px}\n .b46fm-preview-mobile .fm-league{font-size:13px}\n .b46fm-preview-mobile .fm-facts{gap:7px}\n .b46fm-preview-mobile .fm-fact{min-height:52px}\n .b46fm-preview-mobile .fm-stat-info{grid-template-columns:42px minmax(0,1fr) 42px}\n .b46fm-preview-mobile .fm-stat-name{font-size:10.5px}\n .b46fm-preview-mobile .fm-bars{gap:7px}\n .b46fm-preview-mobile .fm-track{height:5px}\n}\n@media(min-width:768px){\n .b46fm-preview-mobile{display:none!important}\n}\n\n/* Explicit preview-only screenshot-reference styling, never mistaken for a live signal */\n.b46fm .fm-sample-signal{display:grid;gap:4px;padding:11px 12px!important}\n.b46fm .fm-sample-signal-top{display:flex;align-items:center;justify-content:space-between;gap:8px}\n.b46fm .fm-sample-signal-top b{color:var(--fm-green)!important;font-size:12px;font-weight:850}\n.b46fm .fm-sample-signal-top span{color:var(--fm-fg);font-size:10px;font-weight:760;text-align:right}\n.b46fm .fm-sample-signal-detail,.b46fm .fm-sample-signal-meta{display:block;color:var(--fm-dim);font-size:9px;line-height:1.35}\n.b46fm .fm-sample-signal-meta{color:var(--fm-green)}\n.b46fm .fm-eyebrow:has(+.fm-league){flex-wrap:wrap}\n\n\n/* V1.2 — SHARP RAISED FACT TILES (owner requested, 2026-10-21).\n   Convex, clean edge-light and a short sharp drop step, NOT inset/recessed.\n   The four labels and values still follow Featured Match source data. */\n.b46fm-preview-pc,.b46fm-preview-mobile{\n --fm-tile-bg:#1B392B;\n --fm-tile-highlight:#2C503C;\n --fm-tile-base:#183225;\n --fm-tile-edge:rgba(177,242,196,.19);\n --fm-tile-step:rgba(1,11,6,.58);\n --fm-tile-ambient:rgba(0,8,4,.26);\n --fm-tile-toplight:rgba(235,255,241,.18);\n --fm-tile-value:#F0F9F1;\n}\nhtml[data-theme=\"light\"] .b46fm-preview-pc,\nhtml[data-theme=\"light\"] .b46fm-preview-mobile{\n --fm-tile-bg:#E2EEE6;\n --fm-tile-highlight:#F8FCF9;\n --fm-tile-base:#D7E7DB;\n --fm-tile-edge:rgba(61,123,75,.21);\n --fm-tile-step:rgba(54,98,64,.26);\n --fm-tile-ambient:rgba(46,96,56,.11);\n --fm-tile-toplight:rgba(255,255,255,.90);\n --fm-tile-value:#1B3D2A;\n}\n.b46fm .fm-facts{\n grid-template-columns:repeat(2,minmax(0,1fr))!important;\n gap:8px!important;\n margin-top:12px!important;\n padding:0!important;\n background:transparent!important;\n}\n.b46fm .fm-fact{\n min-width:0!important;\n min-height:51px!important;\n padding:9px 10px!important;\n border:1px solid var(--fm-tile-edge)!important;\n outline:0!important;\n border-radius:7px!important;\n background-color:var(--fm-tile-bg)!important;\n background-image:linear-gradient(155deg,var(--fm-tile-highlight) 0%,var(--fm-tile-bg) 42%,var(--fm-tile-base) 100%)!important;\n /* Keep the visual edge sharply raised, with no wide soft halo. */\n box-shadow:\n   0 2px 0 var(--fm-tile-step),\n   0 5px 8px -4px var(--fm-tile-ambient),\n   inset 0 1px 0 var(--fm-tile-toplight)!important;\n filter:none!important;\n transform:none!important;\n}\n.b46fm .fm-fact span{\n color:var(--fm-dim)!important;\n font-size:8px!important;\n font-weight:790!important;\n letter-spacing:.07em!important;\n line-height:1.20!important;\n}\n.b46fm .fm-fact b{\n margin-top:5px!important;\n font-weight:830!important;\n font-size:11px!important;\n line-height:1.28!important;\n color:var(--fm-tile-value)!important;\n letter-spacing:-.012em!important;\n}\n.b46fm .fm-fact[data-name*=\"CARDS\"] b{\n font-size:9px!important;\n line-height:1.35!important;\n letter-spacing:-.014em!important;\n}\n.b46fm .fm-fact[data-name*=\"ODDS\"] b{\n font-variant-numeric:tabular-nums;\n}\n@media(max-width:767px){\n .b46fm-preview-mobile .fm-facts{gap:8px!important}\n .b46fm-preview-mobile .fm-fact{min-height:54px!important;padding:9px 10px!important}\n .b46fm-preview-mobile .fm-fact b{font-size:12px!important}\n .b46fm-preview-mobile .fm-fact[data-name*=\"CARDS\"] b{font-size:9.5px!important}\n}\n\n/* BALL46 Featured Match — recessed fact wells, approved design.\n   HALF-TIME / CORNERS / CARDS H·A / ODDS AGE: concave, one step darker,\n   no colored top stroke or floating tile / drop shadow. PC + mobile. */\n.b46fm-preview-pc,.b46fm-preview-mobile{\n --fm-well-top:#0F2219;\n --fm-well-bottom:#142920;\n --fm-well-shadow:rgba(0,7,3,.55);\n --fm-well-lip:rgba(192,240,207,.065);\n --fm-well-value:#E9F6EC;\n}\nhtml[data-theme=\"light\"] .b46fm-preview-pc,\nhtml[data-theme=\"light\"] .b46fm-preview-mobile{\n --fm-well-top:#D8E6DC;\n --fm-well-bottom:#E6F0E9;\n --fm-well-shadow:rgba(36,79,49,.18);\n --fm-well-lip:rgba(255,255,255,.75);\n --fm-well-value:#1C422D;\n}\n.b46fm .fm-facts{\n display:grid!important;\n grid-template-columns:repeat(2,minmax(0,1fr))!important;\n gap:7px!important;\n margin-top:11px!important;\n}\n.b46fm .fm-fact{\n position:relative!important;\n min-height:51px!important;\n border:0!important;\n border-radius:9px!important;\n background:linear-gradient(168deg,var(--fm-well-top),v