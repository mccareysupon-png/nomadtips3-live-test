const css="<style id=\"b46-mobile-stats-clean-v1-20261020\">/* BALL46 Statistics Mobile V1 — clean, readable, source-data-only cards.\n   Narrow screens <=767px only. No PC, backend or settlement changes. */\n@media(max-width:767px){\n html body .workspace.singlepage .sp-stats-content{\n  --b46m-stat-gap:8px;\n  padding:0 6px 12px!important;\n  min-width:0!important;\n  width:100%!important;\n  color:var(--b46m-stat-ink,#E7F5EC);\n }\n html[data-theme=\"dark\"] body .workspace.singlepage .sp-stats-content{\n  --b46m-stat-bg:#16291F;\n  --b46m-stat-bg2:#1C3329;\n  --b46m-stat-ink:#E8F6EE;\n  --b46m-stat-sub:#A4C7B3;\n  --b46m-stat-dim:#83AC93;\n }\n html:not([data-theme=\"dark\"]) body .workspace.singlepage .sp-stats-content{\n  --b46m-stat-bg:#F1F8F3;\n  --b46m-stat-bg2:#E4F0E7;\n  --b46m-stat-ink:#213D2D;\n  --b46m-stat-sub:#567360;\n  --b46m-stat-dim:#6C8977;\n }\n html body .workspace.singlepage .sp-stat-hero{\n  display:flex!important;\n  align-items:center!important;\n  justify-content:space-between!important;\n  min-height:57px!important;\n  padding:9px 11px!important;\n  margin:0 0 8px!important;\n  border:0!important;\n  border-radius:10px!important;\n  background:linear-gradient(116deg,var(--b46m-stat-bg2),var(--b46m-stat-bg))!important;\n  box-shadow:inset 0 1px 0 rgba(255,255,255,.05),0 3px 9px rgba(0,0,0,.11)!important;\n }\n html body .workspace.singlepage .sp-stat-hero .kicker{\n  font-size:9px!important;line-height:1.2!important;letter-spacing:.06em!important;\n }\n html body .workspace.singlepage .sp-stat-hero h3{\n  font-size:15px!important;line-height:1.25!important;font-weight:760!important;\n  letter-spacing:-.025em!important;margin:3px 0 0!important;color:var(--b46m-stat-ink)!important;\n }\n html body .workspace.singlepage .sp-stat-hero p{display:none!important}\n html body .workspace.singlepage .sp-stat-hero .meta{\n  min-width:86px!important;max-width:110px!important;\n  padding:7px 8px!important;border:0!important;border-radius:8px!important