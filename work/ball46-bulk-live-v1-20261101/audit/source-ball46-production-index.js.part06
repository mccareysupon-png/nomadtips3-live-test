hourCycle:'h23'});\nfunction validBucket(b){return b&&['win','loss','push','pending','oddsCount'].every(k=>Number.isSafeInteger(b[k])&&b[k]>=0)&&Number.isFinite(b.oddsSum)&&b.oddsSum>=0&&b.oddsCount<=b.win+b.loss+b.push+b.pending;}\nfunction decodeCache(raw){try{const c=JSON.parse(raw),now=Date.now(),tk=sportDay(now);if(c?.schema!==SCHEMA||c.formula!==FORMULA||c.tz!==TZ||c.cut!==CUT||!Number.isFinite(c.verifiedAt)||c.verifiedAt>now+60000||now-c.verifiedAt>86400000||c.d?.tk!==tk||c.d.yk!==prev(tk)||!validBucket(c.d.today)||!validBucket(c.d.yesterday))return null;return c;}catch{return null;}}\nfunction cacheRead(){try{return decodeCache(localStorage.getItem(CACHE_KEY));}catch{return null;}}\nfunction cacheWrite(){try{localStorage.setItem(CACHE_KEY,JSON.stringify({schema:SCHEMA,formula:FORMULA,tz:TZ,cut:CUT,verifiedAt,d:lastGood}));}catch{}}\nfunction freshness(r){if(!lastGood)return;const fresh=sourceMode==='snapshot'&&Date.now()-verifiedAt<=STALE_MS;const time=timeFormatter.format(new Date(verifiedAt));r.dataset.b46PerformanceState=fresh?'current':'saved';r.dataset.b46PerformanceUpdatedAt=String(verifiedAt);r.title='Last validated Statistics snapshot: '+new Date(verifiedAt).toISOString();text(r,'[data-b46-label=\"today\"]',`${fresh?'Live Summary':'Saved Summary'} · ${dateLabel(lastGood.tk)} · ${time}`);text(r,'[data-b46-label=\"yesterday\"]',`${fresh?'Final Summary':'Saved Summary'} · ${dateLabel(lastGood.yk)}`);}\nfunction showWaiting(){const r=ensure();if(!r)return;r.dataset.b46PerformanceState='waiting';r.removeAttribute('data-b46-performance-updated-at');r.title='Waiting for the existing Statistics snapshot';for(const e of r.querySelectorAll('[data-b46-stat],[data-b46-rate],[data-b46-avg-odds],[data-b46-total]'))e.textContent='—';for(const e of r.querySelectorAll('[data-b46-rate]'))e.setAttribute('data-b46-rate-tone','neutral');const tk=sportDay(Date.now());text(r,'[data-b46-label=\"today\"]',`Awaiting update · ${dateLabel(tk)}`);text(r,'[data-b46-label=\"yesterday\"]',`Awaiting update · ${dateLabel(prev(tk))}`);}\nfunction restoreCache(){const c=cacheRead();if(!c||lastGood&&verifiedAt>=c.verifiedAt)return;lastGood=c.d;verifiedAt=c.verifiedAt;sourceMode='cache';render(lastGood);}\nfunction consume(data){try{const api=window.BALL46_STATISTICS_DATA;if(!api?.getSnapshot||data!==api.getSnapshot()||data?.ok!==true||!Array.isArray(data.ledgerRows)||!Number.isSafeInteger(data.ledgerTotal)||data.ledgerRows.length!==data.ledgerTotal||data.nextCursor!=null||data.hasMore===true)return;const stamp=api.getSnapshotAt?.();if(!Number.isFinite(stamp)||sportDay(stamp)!==sportDay(Date.now()))return;if(lastSnapshot===data&&lastGood?.tk===sportDay(Date.now()))return;lastSnapshot=data;lastGood=aggregate(data.ledgerRows);verifiedAt=stamp;sourceMode='snapshot';render(lastGood);cacheWrite();clearTimeout(ageTimer);ageTimer=setTimeout(()=>{const r=document.getElementById(ID);if(r&&lastGood)freshness(r);},Math.max(1000,verifiedAt+STALE_MS-Date.now()+1));}catch(e){console.warn('B46 Performance snapshot skipped:',e?.message||e);}}\nfunction cutoffStamp(k){const [y,m,d]=k.split('-').map(Number),utc=Date.UTC(y,m-1,d,CUT),p=parts(utc);return utc-(Date.UTC(Number(p.year),Number(p.month)-1,Number(p.day),Number(p.hour))-utc);}\nfunction nextDay(k){const [y,m,d]=k.split('-').map(Number);return new Date(Date.UTC(y,m-1,d)+86400000).toISOString().slice(0,10);}\nfunction checkDay(){if(lastGood&&lastGood.tk!==sportDay(Date.now())){lastGood=null;lastSnapshot=null;showWaiting();}else if(lastGood){const r=ensure();if(r)freshness(r);}scheduleDay();}\nfunction scheduleDay(){clearTimeout(rolloverTimer);rolloverTimer=setTimeout(checkDay,Math.max(1000,cutoffStamp(nextDay(sportDay(Date.now())))-Date.now()+20));}\nfunction boot(){document.addEventListener('ball46:statistics-snapshot',e=>consume(e.detail));ensure();watchAnchor();restoreCache();consume(window.BALL46_STATISTICS_DATA?.getSnapshot?.());if(!lastGood)showWaiting();scheduleDay();document.addEventListener('visibilit