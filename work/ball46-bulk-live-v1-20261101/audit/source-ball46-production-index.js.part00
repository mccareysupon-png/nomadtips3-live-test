le-v3=\"1\"] body .match-row .teams-cell{\n    grid-column:1 / -1!important;\n    grid-row:1!important;\n    display:grid!important;\n    grid-template-columns:minmax(0,1fr) 30px!important;\n    grid-template-rows:auto auto!important;\n    column-gap:8px!important;\n    row-gap:5px!important;\n    width:100%!important;\n    min-width:0!important;\n    align-items:center!important;\n  }\n  html[data-b46-mobile-v3=\"1\"] body .match-row .teams-cell>b.b46-home{grid-column:1!important;grid-row:1!important}\n  html[data-b46-mobile-v3=\"1\"] body .match-row .teams-cell>b.b46-away{grid-column:1!important;grid-row:2!important}\n  html[data-b46-mobile-v3=\"1\"] body .match-row .teams-cell>.desktop-team-score{\n    display:block!important;\n    width:30px!important;\n    min-width:30px!important;\n    text-align:center!important;\n    color:var(--b46m-text)!important;\n    font-size:18px!important;\n    font-weight:900!important;\n    line-height:1!important;\n    font-variant-numeric:tabular-nums!important;\n  }\n  html[data-b46-mobile-v3=\"1\"] body .match-row .teams-cell>b.b46-home + .desktop-team-score{grid-column:2!important;grid-row:1!important}\n  html[data-b46-mobile-v3=\"1\"] body .match-row .teams-cell>b.b46-away + .desktop-team-score{grid-column:2!important;grid-row:2!important}\n\n  /* The old separate score column must not duplicate 0 / 0 anymore. It becomes the single live-time row. */\n  html[data-b46-mobile-v3=\"1\"] body .match-row .score-cell{\n    grid-column:1 / -1!important;\n    grid-row:2!important;\n    display:flex!important;\n    align-items:center!important;\n    justify-content:flex-start!important;\n    width:100%!important;\n    min-width:0!important;\n    min-height:22px!important;\n    padding:0!important;\n    margin:0!important;\n    text-align:left!important;\n  }\n  html[data-b46-mobile-v3=\"1\"] body .match-row .score-cell>strong{display:none!important}\n  html[data-b46-mobile-v3=\"1\"] body .match-row .score-cell>.half-score{display:none!important}\n  html[data-b46-mobile-v3=\"1\"] body .match-row .score-cell>.b46-live-time.b46-live-clock{\n    display:inline-flex!important;\n    align-items:center!important;\n    gap:4px!important;\n    width:auto!important;\n    min-width:0!important;\n    margin:0!important;\n    padding:3px 7px!important;\n    border:1px solid color-mix(in srgb,var(--b46m-green) 38%,var(--b46m-line))!important;\n    border-radius:999px!important;\n    background:color-mix(in srgb,var(--b46m-green) 9%,transparent)!important;\n    color:var(--b46m-green)!important;\n    font-size:10px!important;\n    font-weight:900!important;\n    line-height:1!important;\n    white-space:nowrap!important;\n  }\n\n  /* Legacy mobile duplicated the same LIVE minute inside the signal cell. Remove only that duplicate. */\n  html[data-b46-mobile-v3=\"1\"] body .match-row .signal-inline-stack .mobile-clock,\n  html[data-b46-mobile-v3=\"1\"] body .match-row .signal-cell .mobile-clock{display:none!important}\n  html[data-b46-mobile-v3=\"1\"] body .match-row .signal-inline-stack .desktop-signal,\n  html[data-b46-mobile-v3=\"1\"] body .match-row .signal-cell .desktop-signal{\n    display:block!important;\n    max-width:100%!important;\n    overflow:hidden!important;\n    text-overflow:ellipsis!important;\n    white-space:nowrap!important;\n  }\n\n  /* Performance remains explicitly excluded from Mobile. */\n  html[data-b46-mobile-v3=\"1\"] body .sp-trend.b46-perf-card,\n  html[data-b46-mobile-v3=\"1\"] body .b46-perf-card,\n  html[data-b46-mobile-v3=\"1\"] body .b46-perf-shell{display:none!important}\n}\n</style><script id=\"b46-mobile-v3-script\">/* Ball46 Mobile V3 \u2014 presentation controller only.\n   <=760px: dark-only mobile shell. No API/engine/signal/statistics logic changes. */\n(()=>{\n  'use strict';\n  const mq=window.matchMedia('(max-width:760px)');\n  const root=document.documentElement;\n  let savedTheme=null;\n  let forced=false;\n  const themeMeta=()=>document.querySelector('meta[name=\"theme-color\"]');\n  const apply=()=>{\n    if(mq.matches){\n      if(!forced){savedTheme=root.getAttribute('data-theme');forced=true;}\n      root.setAttribute('data-b46-mobile-v3','1');\n      root.setAttribute('data-theme','dark');\n      const meta=themeMeta(); if(meta) meta.setAttribute('content','#050807');\n    }else{\n      root.removeAttribute('data-b46-mobile-v3');\n      if(forced){\n        if(savedTheme) root.setAttribute('data-theme',savedTheme); else root.removeAttribute('data-theme');\n        forced=false;\n      }\n    }\n  };\n  apply();\n  if(typeof mq.addEventListener==='function') mq.addEventListener('change',apply);\n  else if(typeof mq.addListener==='function') mq.addListener(apply);\n  document.addEventListener('DOMContentLoaded',apply,{once:true});\n})();\n</script>";
  if(!html.includes("b46-mobile-v3-style")){if(!html.includes("</head>"))throw new Error("MOBILE_HEAD_ANCHOR_MISSING");html=html.replace("</head>",payload+"</head>");}
