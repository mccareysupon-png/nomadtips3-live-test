  let html=await res.text(); const payload="<style id=\"b46-mobile-v3-style\">/* Ball46 Mobile Presentation Layer V1 \u2014 2026-10-05\n   Scope: mobile presentation only (<=760px).\n   Source of truth: current Ball46 Production data/logic.\n   Explicitly does NOT change Desktop, Engine, API, Odds, Signals, Statistics logic, HUB or polling. */\n\n@media (max-width:760px){\n  :root{\n    --b46m-bg:#050807;\n    --b46m-surface:#0b110e;\n    --b46m-surface-2:#111915;\n    --b46m-line:#1d2a24;\n    --b46m-text:#f4f7f5;\n    --b46m-muted:#91a099;\n    --b46m-green:#22e178;\n    --b46m-red:#ff4d5d;\n    --b46m-amber:#ffc83d;\n    --b46m-blue:#55a7ff;\n    --b46m-radius:12px;\n    --b46m-gap:8px;\n  }\n\n  html,\n  html[data-theme=\"light\"],\n  html[data-theme=\"dark\"]{\n    color-scheme:dark!important;\n    background:var(--b46m-bg)!important;\n  }\n  html body{\n    margin:0!important;\n    background:var(--b46m-bg)!important;\n    color:var(--b46m-text)!important;\n    overflow-x:hidden!important;\n    padding-bottom:calc(76px + env(safe-area-inset-bottom,0px))!important;\n  }\n\n  .workspace-theme-btn,\n  [data-theme-toggle],\n  .theme-toggle,\n  .next-theme{display:none!important}\n\n  .dash-shell,\n  .shell,\n  .owner-shell{\n    width:100%!important;\n    max-width:100%!important;\n    box-sizing:border-box!important;\n    padding-left:8px!important;\n    padding-right:8px!important;\n  }\n  .workspace.singlepage{\n    display:block!important;\n    width:100%!important;\n    max-width:100%!important;\n    min-width:0!important;\n    margin:0!important;\n    gap:0!important;\n  }\n\n  /* Mobile V3 owns this decision. Specificity intentionally exceeds legacy html body rules. */\n  html[data-b46-mobile-v3=\"1\"] body [data-workspace-scorebar-slot],\n  html[data-b46-mobile-v3=\"1\"] body .workspace-scorebar-slot,\n  html[data-b46-mobile-v3=\"1\"] body .workspace-scorebar-grid,\n  html[data-b46-mobile-v3=\"1\"] body [data-workspace-scorebar-slot] .workspace-scorebar-gr