 .match-row .signal-cell::before,\n  .match-row .signal-cell::after{display:none!important;content:none!important}\n\n  .match-expanded,\n  .fmb-panel,\n  .fmb-group,\n  .expand-flow-chart,\n  .b46-signal-flow-line-chart{\n    max-width:100%!important;\n    min-width:0!important;\n  }\n  .match-expanded{padding:8px!important;border-radius:var(--b46m-radius)!important}\n  .expand-flow-chart svg,\n  .b46-signal-flow-line-chart svg{max-width:100%!important;height:150px!important}\n\n  .fmb-tabs,\n  .fmb-table-wrap,\n  .expand-book-tabs,\n  .expand-odds-table-wrap,\n  .sp-table-wrap,\n  .table-wrap{\n    max-width:100%!important;\n    overflow-x:auto!important;\n    overflow-y:hidden!important;\n    overscroll-behavior-x:contain!important;\n    -webkit-overflow-scrolling:touch!important;\n    scrollbar-width:none!important;\n  }\n  .fmb-tabs::-webkit-scrollbar,\n  .fmb-table-wrap::-webkit-scrollbar,\n  .expand-book-tabs::-webkit-scrollbar,\n  .expand-odds-table-wrap::-webkit-scrollbar,\n  .sp-table-wrap::-webkit-scrollbar,\n  .table-wrap::-webkit-scrollbar{display:none!important}\n  .fmb-market table{min-width:330px!important}\n\n  .sp-kpis{\n    display:grid!important;\n    grid-template-columns:repeat(2,minmax(0,1fr))!important;\n    gap:7px!important;\n  }\n  .sp-kpi{\n    min-width:0!important;\n    min-height:58px!important;\n    padding:9px!important;\n    border:1px solid var(--b46m-line)!important;\n    border-radius:10px!important;\n    background:var(--b46m-surface)!important;\n  }\n  .sp-kpi strong{font-size:16px!important;color:var(--b46m-text)!important}\n  .sp-kpi small{color:var(--b46m-muted)!important}\n\n  .mobile-nav,\n  .next-mobile-nav{display:none!important}\n  .b46-mobile-workspace-nav{\n    position:fixed!important;\n    left:0!important;\n    right:0!important;\n    bottom:0!important;\n    z-index:999!important;\n    display:grid!important;\n    grid-template-columns:repeat(3,minmax(0,1fr))!important;\n    gap:0!important;\n    min-height:62px!i