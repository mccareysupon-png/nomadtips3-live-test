key==='scheduled'?'UPCOMING MATCHES':key==='unknown'?'WAITING':'FINISHED MATCHES'}\nfunction statusDotClass(key){return key==='live'?'live':key==='scheduled'?'upcoming':key==='unknown'?'waiting':'finished'}\nfunction visibleRows(){const signalView=document.body.dataset.workspaceView==='signal';return fixtures.filter(f=>{if(signalView&&!visibleSignalsFor(f).length)return false;if(!signalView&&statusFilter!=='all'&&classify(f)!==statusFilter)return false;if(leagueFilter!=='all'&&leagueName(f)!==leagueFilter)return false;if(query){const hay=[leagueName(f),f?.home?.name,f?.away?.name].filter(Boolean).join(' ').toLowerCase();if(!hay.includes(query))return false}return true})}\nfunction groupByLeague(rows){const map=new Map();for(const f of rows){const key=leagueName(f);if(!map.has(key))map.set(key,[]);map.get(key).push(f)}return[...map.entries()].sort((a,b)=>a[0].localeCompare(b[0]))}\nfunction marketCell(label,data){\n  const title=[data.book,data.stage].filter(Boolean).join(' · '),d=data?.detail||null;\n  const price=v=>num(v)===null?'—':num(v).toFixed(2);\n  const signed=v=>{const n=num(v);if(n===null)return'—';const z=Math.abs(n)<1e-9?0:n;return`${z>0?'+':''}${show(z,2)}`};\n  const plainLine=v=>num(v)===null?'—':show(num(v),2);\n  let body='<div class=\"market-prices market-prices-empty\"><strong>—</strong></div>';\n  if(d?.kind==='1X2'){\n    body=`<div class=\"market-prices market-prices-1x2\"><div class=\"market-quote\"><i>H</i><strong>${esc(price(d.home))}</strong></div><div class=\"market-quote\"><i>D</i><strong>${esc(price(d.draw))}</strong></div><div class=\"market-quote\"><i>A</i><strong>${esc(price(d.away))}</strong></div></div>`;\n  }else if(d?.kind==='AH'){\n    const hl=signed(d.line),al=num(d.line)===null?'—':signed(-num(d.line));\n    body=`<div class=\"market-prices market-prices-ah\"><div class=\"market-price-row\"><i>H</i><em>${esc(hl)}</em><strong>${esc(price(d.home))}</strong></div><div class=\"market-price-row\"><i>A</i><em>${esc(al)}</em><strong>${esc(price(d.away))}</strong></div></div>`;\n  }else if(d?.kind==='OU'){\n    const line=plainLine(d.line);\n    body=`<div class=\"market-prices market-prices-ou\"><div class=\"market-price-row\"><i>O</i><em>${esc(line)}</em><strong>${esc(price(d.over))}</strong></div><div class=\"market-price-row\"><i>U</i><em>${esc(line)}</em><strong>${esc(price(d.under))}</strong></div></div>`;\n  }\n  const kindClass=d?.kind?String(d.kind).toLowerCase().replace(/[^a-z0-9]+/g,'-'):'empty';\n  return `<div class=\"market-cell market-cell-${kindClass}\"${title?` title=\"${esc(title)}\"`:''}><span class=\"market-head\">${esc(label)}${data.stage?` · ${esc(data.stage)}`:''}</span>${body}${data.book?`<small>${esc(data.book)}</small>`:''}</div>`;\n}\n/* B46_CARD_SIGNAL_COUNT_COLLISION_FIX_20261004: card-local count metadata is isolated from the global counter selector. */\n/* B46_CARD_SIGNAL_MORE_COMPACT_20261004: keep match cards height-stable by showing only the first signal inline; +More stays on the same line and full signal detail remains in Featured/Expanded. */\nfunction inlineSignalsHtml(rows){if(!Array.isArray(rows)||!rows.length)return '';return `<div class=\"signal-inline-stack\" data-inline-signal-count=\"${rows.length}\" style=\"min-width:0;display:grid;gap:6px\">${inlineSignalHtml(rows[0],rows.length>1)}</div>`}\nfunction inlineSignalHtml(s,hasMore=false){\n  if(!s)return '<div class=\"signal-cell prediction-live no-pick\"><span class=\"pred-main\">WATCH</span><span class=\"pred-sub\">NO LIVE PICK</span></div>';\n  const market=String(s?.marketLabel||s?.market||'SIGNAL').replace(/^FT_/i,'').replaceAll('_',' ').trim().toUpperCase()||'SIGNAL';\n  const selection=String(s?.selection||'—').trim().toUpperCase()||'—';\n  const line=num(s?.line??s?.selectionLine),odds=num(s?.odds);\n  const lineText=line===null?'':`${line>0?'+':''}${show(line,2)}`;\n  const pick=[selection,lineText].filter(Boolean).join(' ');\n  const sub=odds===null?'LIVE':`@ ${odds.toFixed(2)}`;\n  return `<div class=\"signal-cell locked prediction-live\"><span class=\"pred-main\">${esc(market)} · ${esc(pick)}</span><span class=\"pred-sub\">${esc(sub)}${hasMore?' · +More':''}</span></div>`;\n}\nfunction rowHtml(f){const id=fixtureKey(f),kind=classify(f),active=id===selectedId,sigs=visibleSignalsFor(f),m1=marketCompact(f,'1X2'),mah=marketCompact(f,'AH'),mou=marketCompact(f,'OU'),half=halfScoreLabel(f),pair=scorePair(f),homeScore=kind==='scheduled'?'—':pair.home===null?'—':show(pair.home),awayScore=kind==='scheduled'?'—':pair.away===null?'—':show(pair.away),clock=kind==='live'?`LIVE · ${clockLabel(f)}`:kind==='finished'?'FT':kickoffLabel(f);return `<article class=\"match-row ${active?'active':''}\" data-match-id=\"${esc(id)}\" tabindex=\"0\" role=\"button\" aria-label=\"${esc(f?.home?.name||'Home')} versus ${esc(f?.away?.name||'Away')}\"><div class=\"teams-cell\"><b>${esc(f?.home?.name||'—')}</b><strong class=\"desktop-team-score\" aria-hidden=\"true\">${esc(homeScore)}</strong><b>${esc(f?.away?.name||'—')}</b><strong class=\"desktop-team-score\" aria-hidden=\"true\">${esc(awayScore)}</strong></div><div class=\"score-cell\">${scoreStack(f)}<small>${esc(clock)}</small>${half?`<small class=\"half-score\">${esc(half)}</small>`:''}</div>${marketCell('1X2',m1)}${marketCell('AH',mah)}${marketCell('O/U',mou)}${inlineSignalsHtml(sigs)}</article>`}\n/* BALL46_WORKSPACE_SCOREBAR_20260926 — presentation rail */\n/* BALL46_SCOREBAR_SIGNAL_FLOW_20260928 — first 6 = latest settled Ball46 predictions; last 4 = active PENDING Ball46 signals only */\nfunction renderWorkspaceScorebar(){\n const slot=document.querySelector('[data-workspace-scorebar-slot]');if(!slot)return;\n const resultMeta=raw=>{const r=String(raw||'').trim().toUpperCase();if(r==='WIN')return{cls:'win',label:'WIN'};if(r==='HALF_WIN')return{cls:'win',label:'WIN ½'};if(r==='LOSS')return{cls:'loss',label:'LOSS'};if(r==='HALF_LOSS')return{cls:'loss',label:'LOSS ½'};if(r==='PUSH'||r==='DRAW')return{cls:'draw',label:r==='PUSH'?'PUSH':'DRAW'};return{cls:'draw',label:r||'DRAW'}};\n const scoreText=v=>{const p=pair(v);return p.home===null||p.away===null?'—':show(p.home)+'–'+show(p.away)};\n const liveScoreText=x=>scoreText(x?.mirrorScore??x?.scoreAt??x?.entryScore);\n const lineText=x=>{const n=num(x?.line??x?.selectionLine);if(n===null)return'';const m=String(x?.market||x?.marketLabel||'').toLowerCase();return(/ah|handicap/.test(m)&&n>0?'+':'')+show(n,2)};\n const pickText=x=>[String(x?.selection||'').trim().toUpperCase(),lineText(x)].filter(Boolean).join(' ')||'SIGNAL';\n const marketText=x=>String(x?.marketLabel||x?.market||'SIGNAL').replaceAll('_',' ').replace(/\\s+/g,' ').trim();\n const matchText=x=>[x?.home?.name,x?.away?.name].filter(Boolean).join(' – ')||'—';\n const recent=settledSignalRows.filter(x=>String(x?.status||'').toUpperCase()==='SETTLED'&&['WIN','HALF_WIN','LOSS','HALF_LOSS','PUSH','DRAW'].includes(String(x?.result||'').toUpperCase())).slice().sort((a,b)=>Number(b?.settledAt||b?.createdAt||0)-Number(a?.settledAt||a?.createdAt||0)).slice(0,4);\n const pending=signalRows.filter(x=>String(x?.status||'').toUpperCase()==='PENDING').slice().sort((a,b)=>(num(b?.mirrorMinute??b?.minute??b?.entryMinute)??-1)-(num(a?.mirrorMinute??a?.minute??a?.entryMinute)??-1)||Number(b?.createdAt||0)-Number(a?.createdAt||0));\n const makeSettled=x=>{const r=resultMeta(x?.result),score=scoreText(x?.finalScore),odds=num(x?.odds),league=String(x?.league?.name||'').trim(),market=marketText(x),pick=pickText(x)+(odds===null?'':' @ '+odds.toFixed(2));return '<span class=\"b46-ticker-item is-'+esc(r.cls)+'\" data-b46-ticker-status=\"'+esc(r.label)+'\" title=\"'+esc([league,market,pick].filter(Boolean).join(' · '))+'\"><b class=\"b46-ticker-status\">'+esc(r.label)+'</b><span class=\"b46-ticker-score\">'+esc(score)+'</span><span class=\"b46-ticker-sep\">·</span><span class=\"b46-ticker-match\">'+esc(matchText(x))+'</span><span class=\"b46-ticker-sep\">·</span><span class=\"b46-ticker-market\">'+esc(market)+'</span><span class=\"b46-ticker-pick\">'+esc(pick)+'</span></span>'};\n const makePending=x=>{const minute=num(x?.mirrorMinute??x?.minute??x?.entryMinute),score=liveScoreText(x),odds=num(x?.odds),league=String(x?.league?.name||'').trim(),market=marketText(x),pick=pickText(x)+(odds===null?'':' @ '+odds.toFixed(2)),minuteText=minute===null?'':Math.max(0,Math.round(minute))+\"'\";return '<span class=\"b46-ticker-item is-pending\" data-b46-ticker-status=\"PENDING\" title=\"'+esc([league,market,pick].filter(Boolean).join(' · '))+'\"><b class=\"b46-ticker-status\">PENDING</b>'+(minuteText?'<span class=\"b46-ticker-minute\">'+esc(minuteText)+'</span>':'')+'<span class=\"b46-ticker-score\">'+esc(score)+'</span><span class=\"b46-ticker-sep\">·</span><span class=\"b46-ticker-match\">'+esc(matchText(x))+'</span><span class=\"b46-ticker-sep\">·</span><span class=\"b46-ticker-market\">'+esc(market)+'</span><span class=\"b46-ticker-pick\">'+esc(pick)+'</span></span>'};\n const items=recent.map(makeSettled).concat(pending.map(makePending));\n if(!items.length){slot.__b46ScorebarMarkup='';slot.innerHTML='';return}\n const group='<div class=\"b46-ticker-group\">'+items.join('')+'</div>';\n const markup='<div class=\"b46-signal-ticker\" aria-label=\"Live signal activity\"><div class=\"b46-ticker-track\">'+group+'</div></div>';\n if(slot.__b46ScorebarMarkup===markup)return;\n slot.__b46ScorebarMarkup=markup;slot.innerHTML=markup;\n requestAnimationFrame(()=>{const viewport=slot.querySelector('.b46-signal-ticker'),track=slot.querySelector('.b46-ticker-track'),first=slot.querySelector('.b46-ticker-group');if(!viewport||!track||!first)return;if(items.length<2)return;const shift=Math.max(1,first.getBoundingClientRect().width);let clones=0;do{const clone=first.cloneNode(true);clone.classList.add('b46-ticker-clone');clone.setAttribute('aria-hidden','true');track.appendChild(clone);clones++}while(track.scrollWidth<viewport.clientWidth+shift&&clones<16);track.style.setProperty('--b46-ticker-shift','-'+shift+'px');track.style.setProperty('--b46-ticker-duration',Math.max(18,Math.min(90,shift/34)).toFixed(1)+'s');track.classList.add('is-flowing')});\n}\ndocument.addEventListener('ball46:stable-chrome-ready',renderWorkspaceScorebar);\n/* B46_STABLE_MATCH_CARD_DOM_20261004: preserve keyed match-card DOM across refreshes; rebuild structure only when membership/order really changes. */\nlet stableBoardStructureKey='';\nfunction stableMarkupKey(markup){let h=2166136261;for(let i=0;i<markup.length;i++){h^=markup.charCodeAt(i);h=Math.imul(h,16777619)}return (h>>>0).toString(36)+':'+markup.length}\nfunction bindStableMatchRow(el){if(!el||el.dataset.b46StableBound==='1')return;el.dataset.b46StableBound='1';const choose=()=>{selectedId=el.dataset.matchId;renderBoard();renderFeatured()};el.addEventListener('click',choose);el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();choose()}})}\nfunction bindStableExpandButton(btn){if(!btn||btn.dataset.b46StableBound==='1')return;btn.dataset.b46StableBound='1';btn.addEventListener('click',()=>{const k=btn.dataset.expandGroup;expandedGroups.has(k)?expandedGroups.delete(k):expandedGroups.add(k);renderBoard()})}\nfunction syncStableMatchRow(el,desired,markup){if(!el||!desired)return;const renderKey=stableMarkupKey(markup);if(el.className!==desired.className)el.className=desired.className;for(const name of ['tabindex','role','aria-label']){const next=desired.getAttribute(name);if(next===null)el.removeAttribute(name);else if(el.getAttribute(name)!==next)el.setAttribute(name,next)}if(el.dataset.b46RenderKey!==renderKey){el.innerHTML=desired.innerHTML;el.dataset.b46RenderKey=renderKey}bindStableMatchRow(el)}\nfunction renderBoard(){\n  renderWorkspaceScorebar();\n  const host=$('[data-board-sections]');if(!host)return;\n  const rows=visibleRows(),order=['live','scheduled','unknown','finished'],html=[],structure=[];\n  for(const key of order){\n    const all=rows.filter(f=>classify(f)===key);if(!all.length)continue;\n    const open=expandedGroups.has(key),shown=open?all:all.slice(0,COLLAPSED_LIMIT),leagueGroups=groupByLeague(shown);\n    structure.push([key,all.length,open?1:0,leagueGroups.map(([league,list])=>[league,list.map(fixtureKey)])]);\n    html.push(`<section class=\"status-section\" data-status-section=\"${key}\"><header class=\"status-head\"><div><i class=\"status-dot ${statusDotClass(key)}\"></i><h2>${statusLabel(key)}</h2></div><b>${all.length}</b></header>${leagueGroups.map(([league,list])=>`<section class=\"league-block\"><header class=\"league-head\"><strong>${esc(league)}</strong><span>${list.length} match${list.length===1?'':'es'}</span></header>${list.map(rowHtml).join('')}</section>`).join('')}${all.length>COLLAPSED_LIMIT?`<div class=\"show-more\"><button type=\"button\" data-expand-group=\"${key}\">${open?'Show less':`View all ${all.length}`}</button></div>`:''}</section>`);\n  }\n  const nextHtml=html.length?html.join(''):`<div class=\"board-empty\">${document.body.dataset.workspaceView==='signal'?'No active signals match the current filters.':'No matches match the current filters.'}</div>`;\n  const nextStructureKey=JSON.stringify([document.body.dataset.workspaceView||'',structure,html.length?1:0]);\n  const currentRows=new Map();host.querySelectorAll('[data-match-id]').forEach(el=>{const id=String(el.dataset.matchId||'');if(id&&!currentRows.has(id))currentRows.set(id,el)});\n  const template=document.createElement('template');template.innerHTML=nextHtml;\n  const desiredRows=[...template.content.querySelectorAll('[data-match-id]')];\n  const sameStructure=stableBoardStructureKey===nextStructureKey&&currentRows.size===desiredRows.length&&desiredRows.every(el=>currentRows.has(String(el.dataset.matchId||'')));\n  if(sameStructure){\n    for(const desired of desiredRows){const id=String(desired.dataset.matchId||''),existing=currentRows.get(id);syncStableMatchRow(existing,desired,desired.outerHTML)}\n    stableBoardStructureKey=nextStructureKey;\n    host.querySelectorAll('[data-expand-group]').forEach(bindStableExpandButton);\n    return;\n  }\n  for(const desired of desiredRows){const id=String(desired.dataset.matchId||''),existing=currentRows.get(id);if(existing){syncStableMatchRow(existing,desired,desired.outerHTML);desired.replaceWith(existing)}else{desired.dataset.b46RenderKey=stableMarkupKey(desired.outerHTML);bindStableMatchRow(desired)}}\n  host.replaceChildren(template.content);\n  stableBoardStructureKey=nextStructureKey;\n  host.querySelectorAll('[data-match-id]').forEach(bindStableMatchRow);\n  host.querySelectorAll('[data-expand-group]').forEach(bindStableExpandButton);\n}\nfunction setText(sel,v){const el=$(sel);if(el)el.textContent=String(v??'—')}\nfunction renderSignalMarketCounts(){const counts={all:signalRows.length,'1x2':0,ah:0,ou:0,corners:0,cards:0,other:0};for(const s of signalRows){const k=signalMarketKey(s);if(k in counts)counts[k]++}$$('[data-signal-market-count]').forEach(el=>{const k=el.dataset.signalMarketCount;el.textContent=String(counts[k]||0)})}\nfunction renderCounts(){renderSignalMarketCounts();const counts={live:0,scheduled:0,unknown:0,finished:0};fixtures.forEach(f=>counts[classify(f)]++);for(const [k,v] of Object.entries(counts)){const a=$(`[data-filter-count=\"${k}\"]`),b=$(`[data-overview=\"${k}\"]`);if(a)a.textContent=v;if(b)b.textContent=v}const all=$('[data-filter-count=\"all\"]');if(all)all.textContent=fixtures.length;const activeSignals=signalRows.length,activeMatches=num(signalMirror?.activeMatches)??new Set(signalMap.keys()).size;setText('[data-signal-count]',activeSignals);setText('[data-active-match-count]',activeMatches);const age=num(boardMeta?.hubAgeMs);setText('[data-bulk-age]',age===null?'—':`${Math.max(0,Math.round(age/1000))}s`)}\nfunction renderLeagueFilters(){const host=$('[data-league-filters]');if(!host)return;const map=new Map(),source=document.body.dataset.workspaceView==='signal'?fixtures.filter(f=>visibleSignalsFor(f).length):fixtures;for(const f of source){const l=leagueName(f);map.set(l,(map.get(l)||0)+1)}host.innerHTML=[...map.entries()].sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0])).map(([name,count])=>`<button class=\"league-filter ${leagueFilter===name?'active':''}\" data-league-filter=\"${esc(name)}\"><span>${esc(name)}</span><b>${count}</b></button>`).join('')||'<div class=\"rail-empty\">No leagues available</div>';$$('[data-league-filter]').forEach(btn=>btn.addEventListener('click',()=>{leagueFilter=leagueFilter===btn.dataset.leagueFilter?'all':btn.dataset.leagueFilter;renderLeagueFilters();renderBoard()}))}\nfunction clearFeatured(){selectedId=null;setText('[data-featured-league]','No active signal');setText('[data-featured-status]','—');setText('[data-featured-home]','—');setText('[data-featured-away]','—');setText('[data-featured-score]','—');const signal=$('[data-featured-signal]');if(signal){signal.innerHTML='No active signal';signal.classList.remove('locked');signal.title=''}const prediction=$('[data-prediction-content]');if(prediction){prediction.innerHTML='<div class=\"feature-empty\">NO ACTIVE SIGNAL</div>';prediction.classList.remove('locked');prediction.title='No active signal'}const facts=$('[data-featured-facts]');if(facts)facts.innerHTML='<div><span>HALF-TIME</span><b>—</b></div><div><span>CORNERS</span><b>—</b></div><div><span>CARDS H · A</span><b>—</b></div><div><span>ODDS AGE</span><b>—</b></div>';const stats=$('[data-featured-stats]');if(stats)stats.innerHTML='<div class=\"feature-empty\">No active signal match selected.</div>';const events=$('[data-featured-events]');if(events)events.innerHTML=''}\nfunction renderFeatured(){const signalView=document.body.dataset.workspaceView==='signal',pool=signalView?visibleRows():fixtures;let f=pool.find(x=>fixtureKey(x)===selectedId);if(!f)f=pool.find(x=>classify(x)==='live')||pool.find(x=>classify(x)==='scheduled')||pool[0];if(!f){if(signalView)clearFeatured();return};selectedId=fixtureKey(f);setText('[data-featured-league]',leagueName(f));setText('[data-featured-status]',detailedStatus(f));setText('[data-featured-home]',f?.home?.name||'—');setText('[data-featured-away]',f?.away?.name||'—');setText('[data-featured-score]',scoreLabel(f));const signal=$('[data-featured-signal]'),sigs=visibleSignalsFor(f),hasSignals=sigs.length>0,signalHtml=sigs.map((s,i)=>(i?'<div class=\"feature-signal-divider\" aria-hidden=\"true\" style=\"height:1px;background:var(--line);margin:8px 0\"></div>':'')+signalDetailsHtml(s)).join(''),signalTitle=sigs.map(signalSummary).join(' • ');if(signal){patchFeatureSignalHost(signal,sigs,'');signal.classList.toggle('locked',hasSignals);signal.title=hasSignals?signalTitle:''}const prediction=$('[data-prediction-content]');if(prediction){patchFeatureSignalHost(prediction,sigs,'<div class=\"feature-empty\">WATCH · NO LIVE PICK</div>');prediction.classList.toggle('locked',hasSignals);prediction.title=hasSignals?signalTitle:'No active live prediction'}const facts=$('[data-featured-facts]');if(facts)facts.innerHTML=featureFactsHtml(f);const stats=$('[data-featured-stats]');if(stats)stats.innerHTML=statHtml(f);const events=$('[data-featured-events]');if(events)events.innerHTML=eventsHtml(f)}\nfunction setState(ok,payload){const el=$('[data-state]');if(!el)return;el.classList.remove('live','warn');if(!ok){el.classList.add('warn');el.querySelector('span').textContent='Live data unavailable';return}const age=num(payload?.hubAgeMs??payload?.ageMs),stale=Boolean(payload?.stale);el.classList.add(stale?'warn':'live');const seconds=age===null?null:Math.max(0,Math.round(age/1000));el.querySelector('span').textContent=stale?`Bulk data stale${seconds===null?'':` · ${seconds}s`}`:`Bulk data${seconds===null?' connected':` · ${seconds}s`}`;el.title=[payload?.hubVersion,payload?.version].filter(Boolean).join(' · ')}\nasync function fetchJson(url){const r=await fetch(`${url}${url.includes('?')?'&':'?'}_=${Date.now()}`,{cache:'no-store'});if(!r.ok)throw new Error(`HTTP_${r.status}`);return r.json()}\nasync function loadSignals(){if(document.visibilityState==='hidden')return;try{const j=await fetchJson(SIGNALS_API),rows=Array.isArray(j?.signals)?j.signals:[],next=new Map();rows.sort((a,b)=>Number(b?.createdAt||0)-Number(a?.createdAt||0));for(const s of rows){const id=String(s?.fixtureId??'').trim();if(id&&!next.has(id))next.set(id,s)}signalMap=next;signalRows=rows;signalMirror=j?.mirror&&typeof j.mirror==='object'?j.mirror:{};window.dispatchEvent(new CustomEvent('ball46:signals-snapshot',{detail:{signals:signalRows.slice(),mirror:signalMirror}}))}catch(err){console.warn('Signals refresh failed; keeping last-good signal state',err)}}\nasync function loadScorebarSettlements(){if(document.visibilityState==='hidden')return;try{const j=await window.BALL46_STATISTICS_DATA.load();settledSignalRows=j.rows.slice().sort((a,b)=>Number(b?.settledAt||b?.createdAt||0)-Number(a?.settledAt||a?.createdAt||0));renderWorkspaceScorebar()}catch(err){console.warn('Scorebar settlements refresh failed; keeping last-good settlement state',err)}}\nasync function load(){if(loading||(hasLoaded&&document.visibilityState==='hidden'))return;loading=true;try{const board=await fetchJson(API);if(board?.ok!==true)throw new Error(board?.error||'BOARD_NOT_READY');const rows=Array.isArray(board?.fixtures)?board.fixtures:[];boardMeta=board;fixtures=holdLastGoodOdds(rows).slice().sort((a,b)=>(dateMs(a?.kickoffAt??a?.kickoffUtc)??0)-(dateMs(b?.kickoffAt??b?.kickoffUtc)??0));if(selectedId&&!fixtures.some(f=>fixtureKey(f)===selectedId))selectedId=null;renderCounts();renderLeagueFilters();renderBoard();renderFeatured();setState(true,board)}catch(err){console.warn('Dashboard V2 refresh failed',err);setState(false,null)}finally{loading=false;hasLoaded=true}}\nfunction setTheme(theme){const next=theme==='dark'?'dark':'light';document.documentElement.dataset.theme=next;const btn=$('[data-theme-toggle]');if(btn)btn.textContent=next==='light'?'☾ Dark':'☀ Light';try{localStorage.setItem(THEME_KEY,next)}catch{}}\nfunction initControls(){const tz=$('[data-timezone]');if(tz)tz.textContent=timeZone;const stored=(()=>{try{return localStorage.getItem(THEME_KEY)}catch{return null}})();setTheme(stored==='dark'?'dark':'light');$('[data-theme-toggle]')?.addEventListener('click',()=>setTheme(document.documentElement.dataset.theme==='dark'?'light':'dark'));$$('[data-status-filter]').forEach(btn=>btn.addEventListener('click',()=>{leagueFilter='all';statusFilter=btn.dataset.statusFilter;$$('[data-status-filter]').forEach(x=>x.classList.toggle('active',x===btn));renderLeagueFilters();renderBoard()}));$('[data-search]')?.addEventListener('input',e=>{query=String(e.target.value||'').trim().toLowerCase();renderBoard()});document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')load()})}\nfunction startSignalLoopAfterBoard(){let started=false;const begin=()=>{if(started)return;started=true;setTimeout(()=>{loadSignals();setInterval(loadSignals,SIGNAL_POLL_MS)},SIGNAL_AFTER_BOARD_MS)};const onReady=()=>{if(hasLoaded){window.removeEventListener('ball46:board-first-paint',onReady);begin()}};window.addEventListener('ball46:board-first-paint',onReady);return begin}\nfunction syncWorkspaceMode(){const signalView=document.body.dataset.workspaceView==='signal';setText('[data-featured-kicker]',signalView?'FEATURED SIGNAL':'FEATURED MATCH');setText('[data-prediction-kicker]',signalView?'SIGNAL OUTLOOK':'LIVE PREDICTION');$$('[data-status-filter]').forEach(btn=>btn.classList.toggle('active',!signalView&&btn.dataset.statusFilter===statusFilter))}\nfunction rerenderWorkspaceMode(){syncWorkspaceMode();if(selectedId&&!visibleRows().some(f=>fixtureKey(f)===selectedId))selectedId=null;renderLeagueFilters();renderBoard();renderFeatured()}\nfunction resetLeagueOnWorkspaceView(){leagueFilter='all';rerenderWorkspaceMode()}\nfunction start(){initControls();document.addEventListener('ball46:workspace-view',resetLeagueOnWorkspaceView);document.addEventListener('ball46:signal-market',rerenderWorkspaceMode);syncWorkspaceMode();const beginSignals=startSignalLoopAfterBoard();const first=load();Promise.resolve(first).finally(()=>{window.dispatchEvent(new CustomEvent('ball46:board-first-paint'));beginSignals();setTimeout(()=>{loadScorebarSettlements();setInterval(loadScorebarSettlements,SCOREBAR_STATS_POLL_MS)},SCOREBAR_STATS_AFTER_BOARD_MS)});setInterval(load,POLL_MS);window.NOMAD343_DASHBOARD_V2={version:VERSION,reload:load,mode:'BOARD_FIRST_THEN_SIGNALS',applyRichOdds,getFixture:id=>fixtures.find(f=>fixtureKey(f)===String(id))||null,getSignals:()=>signalRows.slice(),getSignalMirror:()=>signalMirror}}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();\n})();\n";
const __B46_BASE_WORKER__=index_default;

/* __B46_FOOTER_LEGAL_20260929__ */
const __B46_LEGAL_PAGES__={"/information.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>Information &amp; Legal Center | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"active\" href=\"information.html\">Center</a><a class=\"\" href=\"about.html\">About</a><a class=\"\" href=\"user-guide.html\">User Guide</a><a class=\"\" href=\"methodology.html\">Methodology</a><a class=\"\" href=\"privacy.html\">Privacy</a><a class=\"\" href=\"terms.html\">Terms</a><a class=\"\" href=\"disclaimer.html\">Disclaimer</a><a class=\"\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"\" href=\"cookies.html\">Cookies</a><a class=\"\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 • INFORMATION & LEGAL</div><h1>Information &amp; Legal Center</h1><p>Official information, methodology and legal resources for Ball46.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<h2>Information center</h2><p class=\"lead\">Use these official Ball46 pages to understand the service, methodology, privacy practices, terms, responsible-use principles and contact information.</p>\n<h2>Pages prepared</h2><div class=\"grid\">\n<a class=\"card card-link\" href=\"about.html\"><span class=\"card-kicker\">01</span><h3>About Us</h3><p>Who Ball46 is, what the service is designed to do, and its transparency principles.</p><span class=\"arrow\">Open page →</span></a><a class=\"card card-link\" href=\"user-guide.html\"><span class=\"card-kicker\">02</span><h3>User Guide</h3><p>How to read signals, markets, odds snapshots, results and historical statistics.</p><span class=\"arrow\">Open page →</span></a><a class=\"card card-link\" href=\"methodology.html\"><span class=\"card-kicker\">03</span><h3>Methodology</h3><p>High-level signal lifecycle from live data through validation, result and recordkeeping.</p><span class=\"arrow\">Open page →</span></a><a class=\"card card-link\" href=\"privacy.html\"><span class=\"card-kicker\">04</span><h3>Privacy Policy</h3><p>What information may be processed, why, third-party services and user choices.</p><span class=\"arrow\">Open page →</span></a><a class=\"card card-link\" href=\"terms.html\"><span class=\"card-kicker\">05</span><h3>Terms of Service</h3><p>Rules for lawful use, data limitations, intellectual property and service availability.</p><span class=\"arrow\">Open page →</span></a><a class=\"card card-link\" href=\"disclaimer.html\"><span class=\"card-kicker\">06</span><h3>Disclaimer</h3><p>No guarantee of outcomes, changing odds/data and limits of third-party information.</p><span class=\"arrow\">Open page →</span></a><a class=\"card card-link\" href=\"affiliate-disclosure.html\"><span class=\"card-kicker\">07</span><h3>Affiliate Disclosure</h3><p>How affiliate compensation may work and how commercial relationships are separated from signals.</p><span class=\"arrow\">Open page →</span></a><a class=\"card card-link\" href=\"responsible-gambling.html\"><span class=\"card-kicker\">08</span><h3>Responsible Gambling</h3><p>Legal-age use, limits, risk awareness and safer gambling principles.</p><span class=\"arrow\">Open page →</span></a><a class=\"card card-link\" href=\"cookies.html\"><span class=\"card-kicker\">09</span><h3>Cookie Policy</h3><p>Cookie categories that may apply if enabled and how users can control them.</p><span class=\"arrow\">Open page →</span></a><a class=\"card card-link\" href=\"contact.html\"><span class=\"card-kicker\">10</span><h3>Contact</h3><p>Official Ball46 Team contact route without publishing personal identity.</p><span class=\"arrow\">Open page →</span></a></div>\n<h2>How Ball46 is described publicly</h2><div class=\"flow\"><div><span>①</span>Live data</div><div><span>②</span>Conditions</div><div><span>③</span>Validation</div><div><span>④</span>Signal</div><div><span>⑤</span>Result</div><div><span>⑥</span>Statistics</div></div>\n<p>The public description intentionally explains the process without publishing proprietary rules, thresholds, internal scoring, source priority logic or other decision details.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>","/about.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>About Us | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"\" href=\"information.html\">Center</a><a class=\"active\" href=\"about.html\">About</a><a class=\"\" href=\"user-guide.html\">User Guide</a><a class=\"\" href=\"methodology.html\">Methodology</a><a class=\"\" href=\"privacy.html\">Privacy</a><a class=\"\" href=\"terms.html\">Terms</a><a class=\"\" href=\"disclaimer.html\">Disclaimer</a><a class=\"\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"\" href=\"cookies.html\">Cookies</a><a class=\"\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 INFORMATION &amp; LEGAL</div><h1>About Us</h1><p>What Ball46 is, why transparency matters, and what users can reasonably expect.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<h2>1. What Ball46 is</h2><p>Ball46 is a football information and signal service built to turn live match information into clearly presented, time-stamped observations. The service is designed around a simple idea: users should be able to see what was published, when it was published, and what happened afterward.</p>\n<h2>2. Our approach</h2><p>Ball46 combines football data, rule-based conditions, validation steps and historical recordkeeping. A signal is not presented as certainty. It is a recorded output produced when the applicable conditions and checks are satisfied at that moment.</p>\n<div class=\"callout\"><strong>Transparency over promises.</strong> Ball46 focuses on visible signals, recorded outcomes and historical statistics rather than claims of certain wins or assured profit.</div>\n<h2>3. What users can expect</h2><ul><li>Clear identification of the market or signal being displayed.</li><li>Time-sensitive information that may change as a match and market develop.</li><li>Historical results presented for reference and review.</li><li>A distinction between Ball46's analytical process and commercial or affiliate relationships.</li></ul>\n<h2>4. What Ball46 does not promise</h2><p>Football outcomes, market prices and live data are uncertain. Ball46 does not guarantee any prediction, signal, price, profit or future performance. Past results are historical information, not a promise of future results.</p>\n<h2>5. Independence and third-party data</h2><p>Ball46 may use information supplied by independent data providers, bookmakers or other third-party services. Those sources can be delayed, corrected, interrupted or changed without notice. Ball46 may use additional validation or reference data before presenting a signal, but the existence of a third-party data source does not mean that the provider sponsors, endorses or operates Ball46.</p>\n<h2>6. Contact</h2><p>General enquiries can be sent to <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a>. Public communications are made under the name <strong>Ball46 Team</strong>.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>","/user-guide.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>User Guide | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"\" href=\"information.html\">Center</a><a class=\"\" href=\"about.html\">About</a><a class=\"active\" href=\"user-guide.html\">User Guide</a><a class=\"\" href=\"methodology.html\">Methodology</a><a class=\"\" href=\"privacy.html\">Privacy</a><a class=\"\" href=\"terms.html\">Terms</a><a class=\"\" href=\"disclaimer.html\">Disclaimer</a><a class=\"\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"\" href=\"cookies.html\">Cookies</a><a class=\"\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 INFORMATION &amp; LEGAL</div><h1>User Guide</h1><p>A practical guide to reading Ball46 signals, markets, odds snapshots, outcomes and statistics.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<h2>1. Start with the timestamp</h2><p>Live football changes quickly. Read the signal together with its displayed time, match state and any price shown. A later price or match situation may be materially different from the conditions that existed when the signal was recorded.</p>\n<h2>2. Understand the market</h2><h3>1X2</h3><p>A match-result market covering Home, Draw or Away, subject to the market definition shown by the relevant operator or data source.</p><h3>Asian Handicap (AH)</h3><p>A handicap market in which the selected team receives or gives a specified handicap line. Settlement can depend on the exact line and market rules.</p><h3>Over / Under (O/U)</h3><p>A total-goals market based on a displayed goal line. The exact line is essential when interpreting the signal and its later result.</p>\n<h2>3. Odds are snapshots</h2><p>If Ball46 displays odds, they should be treated as a time-sensitive reference. Odds can move, disappear or differ across operators. A price seen later by a user may not match the price recorded when the signal appeared.</p>\n<h2>4. Reading a signal</h2><p>A Ball46 signal should be read as a recorded system output, not an instruction or guarantee. Users should verify the market, line, price, match and operator rules before making any independent decision.</p>\n<h2>5. Results and status labels</h2><p>Where used, result labels such as <strong>WIN</strong>, <strong>LOSS</strong> and <strong>PUSH</strong> describe the recorded settlement outcome under the applicable line and result. A push generally means the selected market is settled without a win or loss under the relevant market rules.</p>\n<h2>6. Historical statistics</h2><p>Historical statistics summarize recorded outcomes over a defined period or sample. Sample size, market mix, odds and push treatment all matter. A high historical win rate does not by itself guarantee profitability or future performance.</p>\n<div class=\"callout warning\"><strong>Important:</strong> never rely on a single percentage without understanding what matches, markets and time period it covers.</div>\n<h2>7. External links</h2><p>Links to bookmakers or other third parties take users to services controlled by those companies. Their prices, terms, eligibility rules and account decisions are separate from Ball46.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>","/methodology.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>Methodology | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"\" href=\"information.html\">Center</a><a class=\"\" href=\"about.html\">About</a><a class=\"\" href=\"user-guide.html\">User Guide</a><a class=\"active\" href=\"methodology.html\">Methodology</a><a class=\"\" href=\"privacy.html\">Privacy</a><a class=\"\" href=\"terms.html\">Terms</a><a class=\"\" href=\"disclaimer.html\">Disclaimer</a><a class=\"\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"\" href=\"cookies.html\">Cookies</a><a class=\"\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 INFORMATION &amp; LEGAL</div><h1>Methodology</h1><p>A public view of the Ball46 signal lifecycle without exposing proprietary K Rules or internal thresholds.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<p class=\"lead\">Ball46 explains its process at a level that can be independently understood without publishing proprietary K Rules, thresholds, internal scoring or source-priority logic.</p>\n<div class=\"flow\"><div><span>①</span>Live data</div><div><span>②</span>Conditions</div><div><span>③</span>Validation</div><div><span>④</span>Signal</div><div><span>⑤</span>Result</div><div><span>⑥</span>Statistics</div></div>\n<h2>1. Live data intake</h2><p>The process begins with current match and market information. Data may include match status, events, prices or other live fields required by the applicable system component.</p>\n<h2>2. Condition screening</h2><p>Incoming information is evaluated against predefined rule-based conditions. The purpose is to reduce arbitrary decision-making and create a consistent trigger process. The exact thresholds and internal rules are proprietary and are not published.</p>\n<h2>3. Validation / referee layer</h2><p>When applicable, a candidate may be checked against a separate reference, price or validation layer before publication. This “referee” concept helps separate the data that produces a candidate from the check used to confirm that the candidate remains valid at that moment.</p>\n<h2>4. Signal creation</h2><p>A signal is created only after the relevant conditions and validation steps are satisfied. It should be associated with the match, market, selection and time information needed to understand what the system recorded.</p>\n<h2>5. Result verification</h2><p>After the event is complete, the recorded signal is evaluated using the applicable final result and market line. Data corrections or exceptional settlement rules may require later review.</p>\n<h2>6. Statistics and audit history</h2><p>Recorded results can then be summarized into historical statistics. Ball46's transparency objective is to preserve a reviewable history rather than selectively displaying only successful signals. If a historical record is corrected because of a confirmed data or settlement error, the correction should be traceable.</p>\n<div class=\"callout safe\"><strong>Design principle:</strong> the same source should not be assumed to be infallible. Where practical, validation is separated from candidate generation.</div>\n<h2>7. Why the full rules are not public</h2><p>The detailed rule set, thresholds, weighting, source-priority logic and implementation are part of Ball46's proprietary system. Public transparency means showing enough information to understand and review outputs; it does not require disclosing the complete internal decision engine.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>","/privacy.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>Privacy Policy | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"\" href=\"information.html\">Center</a><a class=\"\" href=\"about.html\">About</a><a class=\"\" href=\"user-guide.html\">User Guide</a><a class=\"\" href=\"methodology.html\">Methodology</a><a class=\"active\" href=\"privacy.html\">Privacy</a><a class=\"\" href=\"terms.html\">Terms</a><a class=\"\" href=\"disclaimer.html\">Disclaimer</a><a class=\"\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"\" href=\"cookies.html\">Cookies</a><a class=\"\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 INFORMATION &amp; LEGAL</div><h1>Privacy Policy</h1><p>How information may be processed when users visit, contact or interact with Ball46.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<p class=\"lead\">This policy describes a privacy framework for Ball46 without claiming that a specific analytics, advertising or cookie product is active unless it is actually enabled.</p>\n<h2>1. Information you provide</h2><p>If you contact Ball46 by email or another available contact channel, Ball46 may receive the information you choose to provide, such as your email address, message and any attachments or details included by you.</p>\n<h2>2. Technical information</h2><p>Web hosting, security or infrastructure providers may automatically process technical information needed to deliver and protect the service, such as IP address, browser or device information, request time, requested page and basic server logs.</p>\n<h2>3. Analytics and measurement</h2><p>If analytics or performance-measurement tools are enabled, they may process information about visits and interactions. Ball46 should update this policy when a specific analytics or advertising service is introduced.</p>\n<h2>4. Affiliate links and third parties</h2><p>Ball46 may link to third-party websites. When you follow an external or affiliate link, the third party's own privacy and cookie policies apply. Ball46 does not control how an independent third party processes data on its own service.</p>\n<h2>5. Why information may be used</h2><ul><li>To operate, secure and troubleshoot the website.</li><li>To respond to enquiries.</li><li>To understand service performance if measurement tools are enabled.</li><li>To detect abuse, fraud or security threats.</li><li>To meet applicable legal obligations.</li></ul>\n<h2>6. Retention and security</h2><p>Information should be kept only for as long as reasonably necessary for the purpose for which it was collected, legitimate operational needs or applicable legal requirements. Reasonable safeguards may be used, but no internet service can promise absolute security.</p>\n<h2>7. Your choices and rights</h2><p>Privacy rights vary by jurisdiction. Depending on applicable law, users may have rights concerning access, correction, deletion, objection or restriction of certain processing. Requests can be sent to <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a>.</p>\n<h2>8. Changes</h2><p>This policy may be updated when Ball46 adds or changes services, analytics, advertising, affiliate tools or legal requirements. The displayed update date should identify the current version.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>","/terms.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>Terms of Service | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"\" href=\"information.html\">Center</a><a class=\"\" href=\"about.html\">About</a><a class=\"\" href=\"user-guide.html\">User Guide</a><a class=\"\" href=\"methodology.html\">Methodology</a><a class=\"\" href=\"privacy.html\">Privacy</a><a class=\"active\" href=\"terms.html\">Terms</a><a class=\"\" href=\"disclaimer.html\">Disclaimer</a><a class=\"\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"\" href=\"cookies.html\">Cookies</a><a class=\"\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 INFORMATION &amp; LEGAL</div><h1>Terms of Service</h1><p>The basic conditions for accessing and using Ball46 and its informational services.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<h2>1. Acceptance</h2><p>By accessing Ball46, you agree to use the service in accordance with these Terms and any laws that apply to you. If you do not agree, you should not use the service.</p>\n<h2>2. Nature of the service</h2><p>Ball46 provides football information, recorded signals, statistics and related analytical content. The service is informational and does not guarantee any sporting or financial outcome.</p>\n<h2>3. Eligibility and lawful use</h2><p>You are responsible for ensuring that your use of Ball46 and any linked third-party service is lawful where you live and that you meet any applicable age or eligibility requirement.</p>\n<h2>4. Data and availability</h2><p>Live data, odds, event information and third-party feeds can be delayed, incomplete, suspended, corrected or unavailable. Ball46 may modify, suspend or discontinue a feature when reasonably necessary for maintenance, security, data availability or service development.</p>\n<h2>5. No reliance on a fixed price</h2><p>Any price or line shown is time-sensitive. Ball46 does not promise that the same price, line or market will be available when a user visits a third-party operator.</p>\n<h2>6. Intellectual property</h2><p>Ball46 branding, original presentation, proprietary rule logic, internal methodology, software and original content are protected to the extent permitted by applicable law. Users must not attempt to gain unauthorized access to non-public systems, interfere with service operation or misuse content in violation of applicable rights.</p>\n<h2>7. Third-party services</h2><p>External services are operated independently. Their terms, account rules, settlement rules, pricing, availability and regulatory status are their responsibility. A link from Ball46 does not transfer control of those services to Ball46.</p>\n<h2>8. Limitation of assurances</h2><p>Ball46 aims to present information accurately, but does not warrant that all information will always be complete, uninterrupted, error-free or current. Nothing on the service is a guarantee of future performance.</p>\n<h2>9. Changes to these Terms</h2><p>These Terms may be updated as the service changes. Material updates should be reflected by changing the displayed revision date.</p>\n<h2>10. Contact</h2><p>Questions about these Terms can be sent to <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a>.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>","/disclaimer.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>Disclaimer | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"\" href=\"information.html\">Center</a><a class=\"\" href=\"about.html\">About</a><a class=\"\" href=\"user-guide.html\">User Guide</a><a class=\"\" href=\"methodology.html\">Methodology</a><a class=\"\" href=\"privacy.html\">Privacy</a><a class=\"\" href=\"terms.html\">Terms</a><a class=\"active\" href=\"disclaimer.html\">Disclaimer</a><a class=\"\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"\" href=\"cookies.html\">Cookies</a><a class=\"\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 INFORMATION &amp; LEGAL</div><h1>Disclaimer</h1><p>Important limitations concerning signals, statistics, odds, third-party data and financial risk.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<div class=\"callout warning\"><strong>No guaranteed outcome.</strong> Football matches and betting markets involve uncertainty. No Ball46 signal, statistic, historical record or displayed price guarantees a win, profit or future result.</div>\n<h2>1. Informational purpose</h2><p>Ball46 publishes football information, analytical outputs and recorded signals for informational purposes. Users remain responsible for their own decisions and for checking whether any activity is lawful in their jurisdiction.</p>\n<h2>2. Historical performance</h2><p>Past performance is not a reliable promise of future performance. Win rate, recorded returns or other historical statistics can change as more signals are added and can be affected by market type, odds, sample size and settlement method.</p>\n<h2>3. Live-data limitations</h2><p>Live scores, match events, odds and market lines may come from third-party sources. Such information may be delayed, unavailable or corrected after publication. A discrepancy should be checked against the relevant official result and operator market rules.</p>\n<h2>4. Odds and market availability</h2><p>Displayed odds are not an offer by Ball46. Prices and markets can change rapidly and may differ by operator, region, account or time.</p>\n<h2>5. Third-party websites</h2><p>Ball46 is not responsible for the operation, account decisions, payments, settlement, security or content of an independent website reached through an external link.</p>\n<h2>6. Financial risk</h2><p>Betting can result in financial loss. Never treat a statistical pattern or system output as certainty, and never risk money required for essential living expenses.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>","/affiliate-disclosure.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>Affiliate Disclosure | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"\" href=\"information.html\">Center</a><a class=\"\" href=\"about.html\">About</a><a class=\"\" href=\"user-guide.html\">User Guide</a><a class=\"\" href=\"methodology.html\">Methodology</a><a class=\"\" href=\"privacy.html\">Privacy</a><a class=\"\" href=\"terms.html\">Terms</a><a class=\"\" href=\"disclaimer.html\">Disclaimer</a><a class=\"active\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"\" href=\"cookies.html\">Cookies</a><a class=\"\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 INFORMATION &amp; LEGAL</div><h1>Affiliate Disclosure</h1><p>How Ball46 may receive affiliate compensation while keeping commercial relationships separate from signal logic.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<p class=\"lead\">Ball46 may use affiliate links to selected third-party services. This page explains how that commercial relationship works and how it is separated from the analytical process.</p>\n<h2>1. What an affiliate link means</h2><p>Some links on Ball46 may contain a referral or tracking identifier. If a user follows such a link and later registers or uses an eligible service, Ball46 may receive a commission or other compensation from the third party.</p>\n<h2>2. No additional promise to the user</h2><p>An affiliate link does not guarantee a better price, account approval, bonus, market availability, result or service outcome. The third party controls its own terms, eligibility, pricing and account decisions.</p>\n<h2>3. Separation from Ball46 signals</h2><div class=\"callout safe\"><strong>Editorial and system independence:</strong> affiliate compensation should not change Ball46's signal logic, recorded historical results, statistical calculations or the outcome assigned to a signal.</div>\n<h2>4. Operators are independent</h2><p>Unless Ball46 explicitly states otherwise and has authorization to do so, the presence of a link or logo does not mean that an operator is an official Ball46 partner, sponsor or endorser.</p>\n<h2>5. User responsibility</h2><p>Before using a third-party service, users should review the operator's terms, legal availability, responsible-gambling controls, privacy policy and applicable local requirements.</p>\n<h2>6. Disclosure placement</h2><p>Where practical, Ball46 may label or otherwise disclose commercial links near relevant content in addition to maintaining this page.</p>\n<h2>7. Questions</h2><p>Questions concerning affiliate disclosures can be sent to <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a>.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>","/responsible-gambling.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>Responsible Gambling | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"\" href=\"information.html\">Center</a><a class=\"\" href=\"about.html\">About</a><a class=\"\" href=\"user-guide.html\">User Guide</a><a class=\"\" href=\"methodology.html\">Methodology</a><a class=\"\" href=\"privacy.html\">Privacy</a><a class=\"\" href=\"terms.html\">Terms</a><a class=\"\" href=\"disclaimer.html\">Disclaimer</a><a class=\"\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"active\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"\" href=\"cookies.html\">Cookies</a><a class=\"\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 INFORMATION &amp; LEGAL</div><h1>Responsible Gambling</h1><p>Principles intended to support legal, controlled and risk-aware use of betting-related information.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<div class=\"callout\"><strong>Ball46 is not for minors.</strong> Use betting-related information or third-party betting services only if you are of legal age and the activity is lawful in your jurisdiction.</div>\n<h2>1. Treat betting as risk, not income</h2><p>No system can remove uncertainty from sport. Do not treat a signal, prediction or historical win rate as guaranteed income or as a substitute for wages, savings or essential financial planning.</p>\n<h2>2. Set limits before you start</h2><ul><li>Decide in advance how much money and time you are prepared to risk.</li><li>Do not use money needed for housing, food, bills, education, healthcare or debt payments.</li><li>Do not borrow money to bet.</li><li>Do not increase risk simply to recover a previous loss.</li></ul>\n<h2>3. Watch for loss of control</h2><p>Warning signs can include chasing losses, hiding activity, spending longer than intended, borrowing to continue, or allowing betting to harm work, relationships or essential finances.</p>\n<h2>4. Use available controls</h2><p>Licensed operators may provide deposit limits, loss limits, time-outs, self-exclusion or account-closure tools. If betting is becoming difficult to control, consider using those tools and contacting an appropriate local support service.</p>\n<h2>5. Take a break when needed</h2><p>Stopping or stepping away is a valid decision. Ball46 should never be interpreted as encouraging a user to continue betting after reaching personal limits.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>","/cookies.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>Cookie Policy | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"\" href=\"information.html\">Center</a><a class=\"\" href=\"about.html\">About</a><a class=\"\" href=\"user-guide.html\">User Guide</a><a class=\"\" href=\"methodology.html\">Methodology</a><a class=\"\" href=\"privacy.html\">Privacy</a><a class=\"\" href=\"terms.html\">Terms</a><a class=\"\" href=\"disclaimer.html\">Disclaimer</a><a class=\"\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"active\" href=\"cookies.html\">Cookies</a><a class=\"\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 INFORMATION &amp; LEGAL</div><h1>Cookie Policy</h1><p>A transparent framework for cookies, analytics and referral technologies that may be enabled on Ball46.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<p class=\"lead\">This policy uses conditional language because Ball46 should not claim to use a specific cookie or tracking product until that product is actually enabled.</p>\n<h2>1. What cookies are</h2><p>Cookies are small data files that a website or related service may store or read through a browser. Similar technologies can also be used for security, preferences, measurement or referral tracking.</p>\n<h2>2. Categories that may apply</h2><h3>Essential or security technologies</h3><p>These may support site delivery, security, abuse prevention or technical operation.</p><h3>Preference technologies</h3><p>If enabled, these may remember choices such as display or interface preferences.</p><h3>Analytics technologies</h3><p>If analytics are enabled, they may help measure visits, page use and technical performance.</p><h3>Affiliate or referral technologies</h3><p>When a user follows an affiliate link, a third-party operator or affiliate platform may use its own tracking technology to attribute a referral. Its own cookie and privacy terms apply.</p>\n<h2>3. Browser controls</h2><p>Most browsers provide settings to block, delete or restrict cookies. Blocking some technologies may affect website functions or saved preferences.</p>\n<h2>4. External websites</h2><p>After leaving Ball46 for a third-party website, that site's technologies are controlled by the third party, not by Ball46.</p>\n<h2>5. Future updates</h2><p>If Ball46 introduces a specific consent platform, analytics service, advertising tool or tracking technology, this policy should be updated to identify its role and any choices available to users.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>","/contact.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"index,follow\"><title>Contact | Ball46</title><link rel=\"stylesheet\" href=\"legal.css\"></head>\n<body>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand b46-approved-header-brand\" href=\"information.html\"><span class=\"b46-header-logo-image\" role=\"img\" aria-label=\"ball46\"></span><small class=\"b46-header-tagline\">Live signals • transparent records</small></a><div class=\"header-note\">ball46.com</div></div></header>\n\n<div class=\"nav-wrap\"><nav class=\"nav\"><a class=\"\" href=\"information.html\">Center</a><a class=\"\" href=\"about.html\">About</a><a class=\"\" href=\"user-guide.html\">User Guide</a><a class=\"\" href=\"methodology.html\">Methodology</a><a class=\"\" href=\"privacy.html\">Privacy</a><a class=\"\" href=\"terms.html\">Terms</a><a class=\"\" href=\"disclaimer.html\">Disclaimer</a><a class=\"\" href=\"affiliate-disclosure.html\">Affiliate</a><a class=\"\" href=\"responsible-gambling.html\">Responsible Gambling</a><a class=\"\" href=\"cookies.html\">Cookies</a><a class=\"active\" href=\"contact.html\">Contact</a></nav></div>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"eyebrow\"><span class=\"dot\"></span>BALL46 INFORMATION &amp; LEGAL</div><h1>Contact</h1><p>Official public contact information for the Ball46 Team.</p><div class=\"hero-meta\"><span class=\"pill\">Ball46 Team</span><span class=\"pill\">ball46.com</span><span class=\"pill\">jay@ball46.com</span></div></div></section>\n<main><article class=\"article\">\n<p class=\"lead\">Ball46 uses a team identity for public website communications. The site does not need to publish the private identity of the owner in this contact page.</p>\n<div class=\"card\" style=\"margin:26px 0\"><span class=\"card-kicker\">OFFICIAL CONTACT</span><h2 style=\"border:0;padding:0;margin:8px 0 4px\">Ball46 Team</h2><p>Website: <a href=\"https://ball46.com/\"><strong>ball46.com</strong></a><br>Email: <a href=\"mailto:jay@ball46.com\"><strong>jay@ball46.com</strong></a></p></div>\n<h2>What you can contact us about</h2><ul><li>General questions about Ball46.</li><li>Corrections concerning displayed information or historical records.</li><li>Privacy or data-related requests.</li><li>Legal or policy questions.</li><li>Affiliate and commercial enquiries.</li><li>Technical issues with information pages.</li></ul>\n<h2>Include enough detail</h2><p>For a data or signal correction, include the page, match, approximate time and the information you believe should be reviewed. Do not send passwords, payment credentials or other sensitive account secrets.</p>\n<h2>Third-party account support</h2><p>Ball46 cannot access or control accounts held by independent bookmakers or other third parties. Account, payment, identity-verification and withdrawal issues should be directed to the relevant third-party service.</p>\n<div class=\"meta-row\"><span>Last updated: 29 September 2026</span><span>Official Ball46 information</span></div></article></main>\n<footer class=\"site-footer\"><div class=\"footer-inner\"><div class=\"footer-top\"><div><a href=\"/\" aria-label=\"Ball46 home\" style=\"display:inline-block;text-decoration:none\"><div class=\"footer-title footer-brand-image\" role=\"img\" aria-label=\"ball46\"></div></a><div class=\"small\">Transparent football signals and recorded outcomes.</div></div><div class=\"footer-links\"><a href=\"about.html\">About</a><a href=\"user-guide.html\">User Guide</a><a href=\"methodology.html\">Methodology</a><a href=\"privacy.html\">Privacy</a><a href=\"terms.html\">Terms</a><a href=\"disclaimer.html\">Disclaimer</a><a href=\"affiliate-disclosure.html\">Affiliate</a><a href=\"responsible-gambling.html\">Responsible Gambling</a><a href=\"cookies.html\">Cookies</a><a href=\"contact.html\">Contact</a></div></div><div class=\"footer-bottom\"><span>© 2026 Ball46 Team · <a href=\"/\">ball46.com</a></span><span>Contact: <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a></span></div></div></footer>\n</body></html>"};
const __B46_LEGAL_CSS_20261001__=":root{--bg:#f4f7f5;--panel:#ffffff;--ink:#18211d;--muted:#66736c;--line:#dfe7e2;--green:#238a5a;--green2:#31b878;--soft:#eef7f2;--dark:#0d1210}*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:15px;line-height:1.65;-webkit-font-smoothing:antialiased}a{color:inherit}.site-header{background:#fff;border-bottom:1px solid var(--line)}.header-inner{max-width:1180px;margin:0 auto;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;min-width:0}.mark{width:58px;height:42px;border-radius:12px;background:#111714;color:#fff;display:grid;place-items:center;font-size:14px;font-weight:900;letter-spacing:.03em;box-shadow:0 6px 18px rgba(14,24,18,.12)}.mark b{color:var(--green2)}.brand-copy{display:flex;flex-direction:column;line-height:1.2}.brand-copy strong{font-size:15px;letter-spacing:.04em}.brand-copy small{margin-top:4px;color:var(--muted);font-size:11px}.header-note{font-size:12px;color:var(--muted);white-space:nowrap}.nav-wrap{background:#fff;border-bottom:1px solid var(--line);overflow:hidden}.nav{max-width:1180px;margin:0 auto;padding:0 18px;display:flex;gap:4px;overflow-x:auto;scrollbar-width:none}.nav::-webkit-scrollbar{display:none}.nav a{flex:0 0 auto;padding:11px 10px 10px;text-decoration:none;color:#5b6861;font-size:12px;border-bottom:2px solid transparent}.nav a:hover{color:var(--green)}.nav a.active{color:#17201c;font-weight:800;border-bottom-color:var(--green2)}.hero{max-width:1180px;margin:26px auto 0;padding:0 22px}.hero-card{background:linear-gradient(135deg,#fff 0%,#f7fbf8 100%);border:1px solid var(--line);border-radius:18px;padding:30px 32px;box-shadow:0 12px 34px rgba(16,35,24,.06)}.eyebrow{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:800;letter-spacing:.08em;color:var(--green);text-transform:uppercase}.dot{width:7px;height:7px;border-radius:50%;background:var(--green2);box-shadow:0 0 0 4px rgba(49,184,120,.12)}h1{margin:10px 0 8px;font-size:clamp(28px,4vw,42px);line-height:1.12;letter-spacing:-.025em}h2{margin:30px 0 10px;font-size:21px;line-height:1.25}h3{margin:18px 0 6px;font-size:16px}.hero-card>p{max-width:760px;margin:0;color:var(--muted)}.hero-meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.pill{display:inline-flex;align-items:center;padding:6px 10px;border:1px solid var(--line);border-radius:999px;background:#fff;color:#536159;font-size:11px}main{max-width:1180px;margin:18px auto 40px;padding:0 22px}.article{background:#fff;border:1px solid var(--line);border-radius:18px;padding:30px 32px;box-shadow:0 10px 28px rgba(16,35,24,.045)}.article>h2:first-child{margin-top:0}.lead{font-size:16px;color:#445149}.article p,.article li{color:#46534c}.article a{color:#1f7850;text-decoration:none}.article a:hover{text-decoration:underline}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:14px 0 6px}.card{display:block;border:1px solid var(--line);border-radius:14px;padding:18px;background:#fff}.card-link{text-decoration:none;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}.card-link:hover{transform:translateY(-2px);border-color:#b8dcca;box-shadow:0 10px 24px rgba(28,82,53,.08);text-decoration:none}.card-kicker{font-size:10px;font-weight:900;letter-spacing:.09em;color:var(--green);text-transform:uppercase}.card h3{margin:6px 0 5px;color:#17201c}.card p{margin:0 0 10px;font-size:13px;line-height:1.55}.arrow{font-size:11px;font-weight:800;color:var(--green)}.flow{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin:14px 0 18px}.flow>div{min-height:72px;border:1px solid var(--line);border-radius:12px;background:var(--soft);padding:12px 10px;color:#34423a;font-size:12px;font-weight:700}.flow span{display:block;color:var(--green);font-size:17px;margin-bottom:3px}.callout{margin:20px 0;padding:16px 18px;border:1px solid #cfe4d8;border-left:4px solid var(--green2);border-radius:12px;background:#f3faf6;color:#34423a}.callout.warning{border-color:#eadfbe;border-left-color:#c8922b;background:#fffaf0}.callout.safe{border-color:#cfe4d8;border-left-color:var(--green2);background:#f3faf6}.meta-row{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:30px;padding-top:16px;border-top:1px solid var(--line);color:#7a867f;font-size:11px}.site-footer{margin-top:34px;background:var(--dark);color:#c7d0ca;border-top:1px solid rgba(255,255,255,.08)}.footer-inner{max-width:1180px;margin:0 auto;padding:28px 22px 18px}.footer-top{display:flex;justify-content:space-between;gap:28px;align-items:flex-start}.footer-title{font-size:18px;font-weight:900;color:#f5f8f6;letter-spacing:.03em}.small{margin-top:5px;color:#8e9a92;font-size:12px}.footer-links{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:5px 14px;max-width:680px}.footer-links a{color:#aeb9b2;text-decoration:none;font-size:11px}.footer-links a:hover{color:var(--green2)}.footer-bottom{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-top:22px;padding-top:14px;border-top:1px solid rgba(255,255,255,.08);font-size:10px;color:#7f8c84}.footer-bottom a{color:#aeb9b2;text-decoration:none}@media(max-width:820px){.flow{grid-template-columns:repeat(3,minmax(0,1fr))}.footer-top{display:block}.footer-links{justify-content:flex-start;margin-top:16px}}@media(max-width:640px){body{font-size:14px}.header-inner,.hero,main,.footer-inner{padding-left:15px;padding-right:15px}.header-note{display:none}.hero{margin-top:16px}.hero-card,.article{padding:22px 18px;border-radius:14px}.grid{grid-template-columns:1fr}.flow{grid-template-columns:repeat(2,minmax(0,1fr))}.nav{padding:0 8px}.nav a{padding-left:8px;padding-right:8px}.footer-bottom{display:block}.footer-bottom span{display:block;margin-top:5px}}/* B46_FOOTER_BRAND_LOGO_20261001 */.footer-title{font-family:\"Arial Black\",Inter,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-weight:900;letter-spacing:-.055em;text-transform:none}.footer-title span{color:var(--green2)}@media(max-width:640px){.footer-title{width:76px;height:76px;border-radius:19px;background:#000;border:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:24px;line-height:.78;letter-spacing:-.06em;overflow:hidden}.footer-title span{display:block;font-size:42px;line-height:.82;letter-spacing:-.07em;margin-top:1px}}/* B46_REAL_FOOTER_IMAGE_V3_20261001 */.f