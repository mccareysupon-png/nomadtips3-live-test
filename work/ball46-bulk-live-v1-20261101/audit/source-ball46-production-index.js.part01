ooter-brand-image{display:block!important;width:197px!important;height:74px!important;max-width:100%!important;background-image:url(\"data:image/webp;base64,\")!important;background-size:contain!important;background-repeat:no-repeat!important;background-position:left center!important;font-size:0!important;line-height:0!important;color:transparent!important;overflow:hidden!important}@media(max-width:640px){.footer-brand-image{display:block!important;width:76px!important;height:76px!important;border-radius:19px!important;background-image:url(\"data:image/webp;base64,\")!important;background-size:contain!important;background-repeat:no-repeat!important;background-position:center!important}}/* B46_APPROVED_HEADER_LOGO_20261001 */.b46-approved-header-brand{display:flex!important;flex-direction:column!important;align-items:flex-start!important;justify-content:center!important;gap:2px!important;text-decoration:none!important;min-width:0!important}.b46-header-logo-image{display:block!important;width:126px!important;height:38px!important;background-image:url(\"data:image/webp;base64,\")!important;background-size:contain!important;background-repeat:no-repeat!important;background-position:left center!important;flex:none!important}.b46-header-tagline{display:block!important;margin:0!important;color:var(--muted)!important;font-size:11px!important;line-height:1.2!important;white-space:nowrap!important}@media(max-width:640px){.b46-approved-header-brand{flex-direction:row!important;align-items:center!important;gap:10px!important}.b46-header-logo-image{width:46px!important;height:46px!important;border-radius:12px!important;background-image:url(\"data:image/webp;base64,\")!important;background-position:center!important}.b46-header-tagline{font-size:10px!important;white-space:normal!important;max-width:150px!important}}/* B46_TRANSPARENT_LOGO_20261002 */.footer-brand-image,.b46-header-logo-image{background-color:transparent!important;border:0!important;box-shadow:none!important;filter:drop-shadow(0 1px 1px rgba(13,18,16,.26))!important}.b46-header-logo-image{background-image:url(\"data:image/webp;base64,\")!important;background-repeat:no-repeat!important;background-size:contain!important}.footer-brand-image,.b46-header-logo-image{border-radius:0!important}.footer-brand-image{background-position:left center!important}.b46-header-logo-image{background-position:left center!important}@media(max-width:640px){.b46-header-logo-image{background-image:url(\"data:image/webp;base64,\")!important;background-color:transparent!important;border:0!important;box-shadow:none!important;border-radius:0!important;background-position:center!important}}/* B46_LIGHT_LOGO_20261002 */.b46-header-logo-image{background-image:url(\"data:image/webp;base64,\")!important;background-color:transparent!important;border:0!important;box-shadow:none!important;filter:none!important;background-repeat:no-repeat!important;background-size:contain!important}.footer-brand-image{background-position:left center!important}.b46-header-logo-image{background-position:left center!important}@media(max-width:640px){.b46-header-logo-image{background-image:url(\"data:image/webp;base64,\")!important;background-color:transparent!important;border:0!important;box-shadow:none!important;filter:none!important;background-position:center!important}}\n/* B46_DECORATIVE_BORDER_CLEANUP_20261002: information page frames only */\n.hero-card, .article, .card { border-color: transparent !important; }\n.site-header, .nav-wrap, .site-footer, .footer-bottom { border-color: color-mix(in srgb, var(--line) 35%, transparent) !important; }\n\n/* B46_CLEAN_MENU_SURFACES_20261003: informational menu/content separators, not active navigation */\n.site-header, .nav-wrap, .site-footer, .footer-bottom, .meta-row, .pill, .flow > div { border-color: transparent !important; }\n.hero-card, .article { box-shadow: none !important; }\n\n/* B46_MAIN_CARDS_SQUARE_20261003: main card corners only; controls and data graphics retain their shapes */\nbody :is(.hero-card,.article,.card) { border-radius: 0 !important; }\n";
const __B46_FOOTER_HTML__="<footer id=\"b46-site-footer-v1\" aria-label=\"Ball46 footer\">\n  <div class=\"b46f-inner\">\n    <div class=\"b46f-grid\">\n      <section class=\"b46f-brandcol\">\n        <div class=\"b46f-brand\">ball<span>46</span></div>\n        <div class=\"b46f-domain\">ball46.com</div>\n        <p class=\"b46f-copy\">Independent football data, live match information and market analysis presented with transparent recorded outcomes.</p>\n      </section>\n      <nav aria-label=\"Ball46 product links\">\n        <h3>Product</h3>\n        <a href=\"/index.html\">Live</a>\n        <a href=\"/index.html?view=signal\">Signals</a>\n        <a href=\"/index.html?view=statistics\">Statistics</a>\n      </nav>\n      <nav aria-label=\"Ball46 information and legal links\">\n        <h3>Information</h3>\n        <a href=\"/information.html\">Information Center</a>\n        <a href=\"/about.html\">About Us</a>\n        <a href=\"/user-guide.html\">User Guide</a>\n        <a href=\"/methodology.html\">Methodology</a>\n        <a href=\"/privacy.html\">Privacy Policy</a>\n        <a href=\"/terms.html\">Terms of Service</a>\n        <a href=\"/disclaimer.html\">Disclaimer</a>\n        <a href=\"/affiliate-disclosure.html\">Affiliate Disclosure</a>\n        <a href=\"/responsible-gambling.html\">Responsible Gambling</a>\n        <a href=\"/cookies.html\">Cookie Policy</a>\n      </nav>\n      <section>\n        <h3>Contact</h3>\n        <div class=\"b46f-contact\">\n          <a href=\"mailto:jay@ball46.com\">jay@ball46.com</a>\n          <div class=\"b46f-domain\">Official Ball46 Team contact</div>\n        </div>\n      </section>\n    </div>\n    <div class=\"b46f-bottom\">\n      <span>© 2026 Ball46 Team. All Rights Reserved.</span>\n      <span class=\"b46f-note\">Information and entertainment purposes only. Ball46 does not accept bets, process gambling transactions, hold customer funds, or guarantee outcomes.</span>\n    </div>\n  </div>\n</footer>";
const __B46_FOOTER_CSS__="/* Ball46 global footer v1 — presentation only, no runtime/API logic */\n#b46-site-footer-v1{width:100%;box-sizing:border-box;background:#0d1210;border-top:1px solid rgba(255,255,255,.09);color:#c9d0cb;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;margin-top:28px}\n#b46-site-footer-v1 *{box-sizing:border-box}\n#b46-site-footer-v1 .b46f-inner{max-width:1240px;margin:0 auto;padding:30px 22px 18px}\n#b46-site-footer-v1 .b46f-grid{display:grid;grid-template-columns:1.55fr 1fr 1fr 1.25fr;gap:28px}\n#b46-site-footer-v1 .b46f-brand{font-weight:900;letter-spacing:.02em;font-size:21px;color:#f2f5f3}\n#b46-site-footer-v1 .b46f-brand span{color:#31b878}\n#b46-site-footer-v1 .b46f-domain{margin-top:8px;font-size:12px;color:#8f9a93}\n#b46-site-footer-v1 .b46f-copy{margin-top:10px;max-width:360px;font-size:12px;line-height:1.65;color:#9ca7a0}\n#b46-site-footer-v1 h3{margin:0 0 11px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#e6ebe8}\n#b46-site-footer-v1 a{display:block;margin:7px 0;color:#aab4ae;text-decoration:none;font-size:12px;line-height:1.4}\n#b46-site-footer-v1 a:hover{color:#31b878}\n#b46-site-footer-v1 .b46f-contact{padding:12px 13px;border:1px solid rgba(255,255,255,.08);border-radius:10px;background:rgba(255,255,255,.025)}\n#b46-site-footer-v1 .b46f-contact a{color:#dfe6e2;word-break:break-word}\n#b46-site-footer-v1 .b46f-bottom{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;border-top:1px solid rgba(255,255,255,.07);margin-top:24px;padding-top:14px;font-size:10px;line-height:1.55;color:#76827a}\n#b46-site-footer-v1 .b46f-note{max-width:700px;text-align:right}\n@media(max-width:860px){#b46-site-footer-v1 .b46f-grid{grid-template-columns:1fr 1fr}#b46-site-footer-v1 .b46f-brandcol{grid-column:1/-1}}\n@media(max-width:560px){#b46-site-footer-v1 .b46f-inner{padding:24px 16px 16px}#b46-site-footer-v1 .b46f-grid{grid-template-columns:1fr;gap:20px}#b46-site-footer-v1 .b46f-brandcol{grid-column:auto}#b46-site-footer-v1 .b46f-bottom{display:block}#b46-site-footer-v1 .b46f-note{text-align:left;margin-top:7px}}/* B46_FOOTER_BRAND_LOGO_20261001 */#b46-site-footer-v1 .b46f-brand{font-family:\"Arial Black\",Inter,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-weight:900;letter-spacing:-.055em;text-transform:none}#b46-site-footer-v1 .b46f-brand span{color:#31b878}@media(max-width:560px){#b46-site-footer-v1 .b46f-brand{width:76px;height:76px;border-radius:19px;background:#000;border:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:24px;line-height:.78;letter-spacing:-.06em;overflow:hidden}#b46-site-footer-v1 .b46f-brand span{display:block;font-size:42px;line-height:.82;letter-spacing:-.07em;margin-top:1px}}\n/* B46_DECORATIVE_BORDER_CLEANUP_20261002: footer decoration only */\n#b46-site-footer-v1 .b46f-contact { border-color: transparent !important; }\n#b46-site-footer-v1 .b46f-bottom { border-top-color: color-mix(in srgb, var(--line) 35%, transparent) !important; }\n\n/* B46_CLEAN_MENU_SURFACES_20261003: unframed footer surface */\n#b46-site-footer-v1, #b46-site-footer-v1 .b46f-bottom { border-color: transparent !important; }\n";
