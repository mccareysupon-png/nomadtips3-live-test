/* B46_STATISTICS_ODDS_FORMAT_20261003: transform only the existing public odds formatter response so current Statistics V2 joins the same DEC/FRA/AM preference. */
async function __b46OddsFormatForStatistics(request,env){
  const response=await env.ASSETS.fetch(request);
  if(!response.ok)return response;
  const source=await response.text();
  const before="root.querySelectorAll?.('td.odds').forEach(convertDirectElement);";
  const after="root.querySelectorAll?.('td.odds, [data-sp-table-body] > tr > td:nth-child(6), .odds-readonly').forEach(convertDirectElement);";
  const hits=source.split(before).length-1;
  const body=hits===1?source.replace(before,after):source;
  const headers=new Headers(response.headers);
  headers.set('cache-control','no-store, no-cache, must-revalidate, max-age=0');
  headers.set('pragma','no-cache');
  headers.set('expires','0');
  headers.set('x-ball46-odds-statistics','B46_STATISTICS_ODDS_FORMAT_20261003');
  headers.set('x-ball46-odds-statistics-source',hits===1?'patched':'source-mismatch');
  headers.delete('content-length');
  return new Response(body,{status:response.status,statusText:response.statusText,headers});
}

