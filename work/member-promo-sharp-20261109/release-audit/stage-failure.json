  "previousHead": "<style id=\"b46-member-promo-release-20261104\">/* BALL46 member promotion: isolated visual component, no data requests. */\n.b46mp-card{\n --b46mp-lime:#d4fb91;position:relative;display:block;isolation:isolate;\n width:100%;height:156px!important;min-height:156px!important;max-height:156px!important;flex:0 0 auto;margin:0;overflow:hidden;border:0;border-radius:14px;\n background:#0a281b;color:#fff!important;text-decoration:none!important;\n box-shadow:0 10px 25px rgb(0 15 9 / .16),inset 0 1px 0 rgb(225 255 236 / .12);\n font-family:Arial,Helvetica,sans-serif;contain:layout paint;\n}\n.b46mp-photo{position:absolute;inset:0;z-index:-3;display:block;width:100%;height:100%;object-fit:cover;object-position:right top;pointer-events:none}\n.b46mp-card::before{content:\"\";position:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,rgba(3,24,15,.98)0%,rgba(5,33,21,.95)30%,rgba(7,39,25,.79)51%,rgba(8,39,26,.15)76%,rgba(4,25,15,.04)100%);pointer-events:none}\n.b46mp-card::after{content:\"\";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 0 100%,rgb(84 165 85 / .22),transparent 65%);box-shadow:inset 0 1px 0 rgb(236 255 239 / .13),inset 0 -1px 0 rgb(0 10 5 / .13);pointer-events:none}\n.b46mp-content{position:relative;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:0;height:100%;width:65%;padding:13px 0 13px 15px;box-sizing:border-box}\n.b46mp-kicker{display:flex;align-items:center;gap:6px;margin:0 0 8px;color:#e2efdf;font-size:8.5px;line-height:1.2;font-weight:800;letter-spacing:1.05px;white-space:nowrap}\n.b46mp-kicker::before{content:\"\";width:3px;height:9px;border-radius:2px;background:var(--b46mp-lime);box-shadow:0 0 10px rgb(170 242 117 / .28)}\n.b46mp-title{display:block;margin:0;padding:0;color:#fff;font-size:21px;line-height:1.02;font-weight:900;letter-spacing:-.8px;text-align:left}\n.b46mp-title>span{display:block;white-space:nowrap}\n.b46mp-title .b46mp-accent{margin-top:2px;color:var(--b46mp-lime)}\n.b46mp-letter{display:inline-block;animation:b46mp-letter-lift .78s cubic-bezier(.2,.7,.25,1) both;animation-delay:calc(.12s + var(--b46mp-i)*.065s)}\n.b46mp-note{margin:7px 0 10px;color:#d9e9d8;font-size:10px;line-height:1.25;letter-spacing:.05px;white-space:nowrap}\n.b46mp-cta{display:inline-flex;align-items:center;gap:8px;min-height:28px;padding:0 10px;border-radius:6px;box-sizing:border-box;background:var(--b46mp-lime);color:#14301e;font-size:10.5px;line-height:1;font-weight:800;letter-spacing:.05px;white-space:nowrap;box-shadow:0 3px 9px rgb(0 16 7 / .16)}\n.b46mp-cta svg{display:block;width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}\n.b46mp-card:hover .b46mp-cta,.b46mp-card:focus-visible .b46mp-cta{background:#e1ffac;color:#123920}\n.b46mp-card:hover .b46mp-letter,.b46mp-card:focus-visible .b46mp-letter{animation-name:b46mp-letter-replay;animation-duration:.72s}\n.b46mp-card:focus-visible{outline:3px solid #73cf96;outline-offset:3px}\n/* Light palette: natural photograph, mint-white surface, evergreen typography. */\n.b46mp-card[data-b46mp-theme=\"light\"]{\n --b46mp-lime:#167648;background:#edf6e9;color:#163d2b!important;\n box-shadow:0 8px 22px rgb(24 65 39 / .10);\n}\n.b46mp-card[data-b46mp-theme=\"light\"]::before{background:linear-gradient(90deg,rgba(247,252,243,.99)0%,rgba(242,249,235,.98)30%,rgba(237,247,232,.88)51%,rgba(239,249,235,.12)77%,rgba(244,251,239,0)100%)}\n.b46mp-card[data-b46mp-theme=\"light\"]::after{background:radial-gradient(ellipse at 0 100%,rgb(188 222 164 / .25),transparent 65%);box-shadow:inset 0 1px 0 rgb(255 255 255 / .65)}\n.b46mp-card[data-b46mp-theme=\"light\"] .b46mp-kicker{color:#42634b}\n.b46mp-card[data-b46mp-theme=\"light\"] .b46mp-kicker::before{background:#278653;box-shadow:none}\n.b46mp-card[data-b46mp-theme=\"light\"] .b46mp-title{color:#163d2b}\n.b46mp-card[data-b46mp-theme=\"light\"] .b46mp-note{color:#48624b}\n.b46mp-card[data-b46mp-theme=\"light\"] .b46mp-cta{background:#17643c;color:#fff;box-shadow:0 3px 8px rgb(21 74 43 / .12)}\n.b46mp-card[data-b46mp-theme=\"light\"]:hover .b46mp-cta,.b46mp-card[data-b46mp-theme=\"light\"]:focus-visible .b46mp-cta{background:#1d7b48;color:#fff}\n.b46mp-card[data-b46mp-theme=\"light\"]:focus-visible{outline-color:#17643c}\n@keyframes b46mp-letter-lift{0%,100%{transform:translateY(0);opacity:1}40%{transform:translateY(-2.5px);opacity:1}}\n@keyframes b46mp-letter-replay{0%,100%{transform:translateY(0)}40%{transform:translateY(-2.5px)}}\n@media(max-width:760px){\n .b46mp-card{height:160px!important;min-height:160px!important;max-height:160px!important;margin-bottom:12px;border-radius:12px}\n .b46mp-content{padding-left:15px;width:61%}\n .b46mp-kicker{font-size:8.5px;margin-bottom:8px}\n .b46mp-title{font-size:23px}\n .b46mp-note{font-size:10.5px}\n .b46mp-cta{font-size:11px;min-height:28px}\n}\n@media(prefers-reduced-motion:reduce){\n .b46mp-card .b46mp-letter{animation:none!important;transform:none!important}\n}\n\n\r\n</style>\n<script id=\"b46-member-promo-script-20261104\">/* Presentation only: reads existing theme preference; no writes or data requests. */\n(()=>{\n'use strict';\nconst LINK='https://member.ball46.com/pricing',IMAGE='/b46-member-promo-20261104.jpg?v=2';\nconst THEME_KEY='nomad343_dashboard_theme_v1';\nfunction selectedTheme(){\n try{return localStorage.getItem(THEME_KEY)==='dark'?'dark':'light';}\n catch{return document.documentElement.dataset.theme==='dark'?'dark':'light';}\n}\nfunction create(){\n const card=document.createElement('a');card.className='b46mp-card';card.href=LINK;card.target='_blank';card.rel='noopener noreferrer';\n card.dataset.b46mpTheme=selectedTheme();\n card.setAttribute('aria-label','Explore BALL46 membership (opens in a new tab)');\n card.innerHTML='<img class=\"b46mp-photo\" src=\"'+IMAGE+'\" alt=\"\" width=\"1774\" height=\"887\" loading=\"lazy\" decoding=\"async\">'+\n '<div class=\"b46mp-content\"><p class