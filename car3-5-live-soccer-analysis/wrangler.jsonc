{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nomadtips3-car35-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  // Owner bookmaker selection is persisted by CAR 3.1 config; Preview does not override the current source.
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
