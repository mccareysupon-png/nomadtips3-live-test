{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ball46-member-production",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_STAGE": "production"
  }
}
