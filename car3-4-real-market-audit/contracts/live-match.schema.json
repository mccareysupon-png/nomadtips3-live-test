{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomadtips3.com/contracts/car3-1-live-match.schema.json",
  "title": "CAR 3.1 Normalized Live Match",
  "type": "object",
  "required": [
    "source",
    "sourceMatchId",
    "league",
    "minute",
    "status",
    "home",
    "away",
    "score",
    "stats",
    "collectedAt"
  ],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "sourceMatchId": { "type": ["string", "number"] },
    "canonicalMatchId": { "type": ["string", "null"] },
    "league": { "type": "string" },
    "country": { "type": ["string", "null"] },
    "kickoffUtc": { "type": ["string", "null"] },
    "minute": { "type": ["number", "null"] },
    "status": { "type": "string" },
    "home": { "type": "string" },
    "away": { "type": "string" },
    "score": { "$ref": "#/$defs/pair" },
    "stats": {
      "type": "object",
      "required": ["possession", "attacks", "dangerous_attacks", "shots", "shots_on_target", "corners", "red_cards"],
      "properties": {
        "possession": { "$ref": "#/$defs/pair" },
        "attacks": { "$ref": "#/$defs/pair" },
        "dangerous_attacks": { "$ref": "#/$defs/pair" },
        "shots": { "$ref": "#/$defs/pair" },
        "shots_on_target": { "$ref": "#/$defs/pair" },
        "corners": { "$ref": "#/$defs/pair" },
        "red_cards": { "$ref": "#/$defs/pair" }
      },
      "additionalProperties": true
    },
    "odds": {
      "type": "object",
      "properties": {
        "oneXtwo": {
          "type": "object",
          "properties": {
            "home": { "type": ["number", "null"] },
            "draw": { "type": ["number", "null"] },
            "away": { "type": ["number", "null"] }
          }
        },
        "asianHandicap": { "type": ["object", "null"] }
      }
    },
    "provenance": { "type": "object" },
    "collectedAt": { "type": "string" },
    "sourceFreshnessSeconds": { "type": ["number", "null"] },
    "matchConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "pair": {
      "type": "object",
      "required": ["home", "away"],
      "properties": {
        "home": { "type": ["number", "null"] },
        "away": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
