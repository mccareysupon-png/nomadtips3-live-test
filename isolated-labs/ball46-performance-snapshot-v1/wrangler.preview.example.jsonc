{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ball46-performance-snapshot-preview-only",
  "main": "./preview-worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "SNAPSHOT_DB",
      "database_name": "ball46-performance-snapshot-preview-only",
      "database_id": "REPLACE_WITH_NEW_DEDICATED_PREVIEW_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
