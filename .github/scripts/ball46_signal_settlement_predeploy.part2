if len(vs)!=1 or float(vs[0].get('percentage',0))!=100: raise SystemExit('MIXED_DEPLOYMENT')
vid=vs[0]['version_id']
if vid!='8d386fb0-1646-4cc5-a15e-da38dc68974f': raise SystemExit('PRODUCTION_VERSION_MOVED:'+vid)
