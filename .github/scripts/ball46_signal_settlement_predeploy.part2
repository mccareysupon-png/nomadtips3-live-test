if got!=exp: raise SystemExit('BINDINGS_CHANGED:'+repr(got))
ss=get(f'{api}/workers/scripts/{s}/schedules')['result']; ss=ss.get('schedules',[]) if isinstance(ss,dict) else (ss or []); cr=[x.get('cron') for x in ss if isinstance(x,dict) and x.get('cron')]
if cr!=['* * * * *']: raise SystemExit('CRON_CHANGED:'+repr(cr))
(r/'runtime/index.js').write_bytes(runtime); (r/'production-version.txt').write_text(vid)
print('PRODUCTION_LOCK_PASS',vid,sha)
