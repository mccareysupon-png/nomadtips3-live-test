insert=s.index('async function load(){',s.index('async function loadSignals(){'))
loader="async function loadScorebarSettlements(){if(document.visibilityState==='hidden')return;try{const j=await fetchJson(STATISTICS_API),rows=Array.isArray(j?.rows)?j.rows:[];settledSignalRows=rows.filter(x=>String(x?.status||'').toUpperCase()==='SETTLED').slice().sort((a,b)=>Number(b?.settledAt||b?.createdAt||0)-Number(a?.settledAt||a?.createdAt||0));renderWorkspaceScorebar()}catch(err){console.warn('Scorebar settlements refresh failed; keeping last-good settlement state',err)}}\n"
s=s[:insert]+loader+s[insert:]
