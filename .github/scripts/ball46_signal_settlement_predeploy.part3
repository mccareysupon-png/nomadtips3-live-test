import json,pathlib
r=pathlib.Path('/tmp/b46-signal-settlement-pre/verify'); st=json.load(open(r/'statistics.json')); bo=json.load(open(r/'board.json')); si=json.load(open(r/'signals.json'))
rows=[x for x in st.get('rows',[]) if str(x.get('status','')).upper()=='SETTLED' and str(x.get('result','')).upper() in {'WIN','HALF_WIN','LOSS','HALF_LOSS','PUSH','DRAW'}]; rows.sort(key=lambda x:x.get('settledAt') or x.get('createdAt') or 0,reverse=True)
if len(rows)<6: raise SystemExit('NOT_ENOUGH_SETTLED_SIGNALS')
live=[x for x in bo.get('fixtures',[]) if str(x.get('boardState','')).lower()=='live']; live.sort(key=lambda x:(x.get('minute') if isinstance(x.get('minute'),(int,float)) else -1),reverse=True)
summary=[{'result':x.get('result'),'match':f"{x.get('home',{}).get('name')} v {x.get('away',{}).get('name')}",'market':x.get('market'),'selection':x.get('selection'),'line':x.get('line'),'odds':x.get('odds'),'finalScore':x.get('finalScore')} for x in rows[:6]]
(r/'expected-latest-six.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2)); print('DATA_TRUTH_PASS settled',len(rows),'live',len(live),'activeSignals',len(si.get('signals',[]))); print(json.dumps(summary,ensure_ascii=False))
