import hashlib
r=Path('/tmp/b46-signal-settlement-pre'); paths=[x.strip() for x in (r/'paths.txt').read_text().splitlines() if x.strip()]; changed=[]
for p in paths:
 a=(r/'base'/p).read_bytes(); b=(r/'candidate'/p).read_bytes()
 if a!=b: changed.append(p)
print('CHANGED_ASSETS',changed)
if changed!=['dashboard-v2-stage3.js','index.html','singlepage-workspace-343.css']: raise SystemExit('DIFF_GATE_FAIL')
